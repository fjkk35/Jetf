<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">
  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="logDirectory" value="${basedir}/logs" />

  <targets>
    <target xsi:type="Console"
            name="console"
            layout="${date:format=HH\:mm\:ss} [${uppercase:${level}}] ${message}${onexception:${newline}${exception:format=tostring}}" />

    <target xsi:type="File"
            name="systemFile"
            fileName="${var:logDirectory}/${shortdate}/Unknown.log"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff zzz} [${uppercase:${level}}] ${message}${onexception:${newline}${exception:format=tostring}}"
            encoding="utf-8"
            keepFileOpen="false" />

    <target xsi:type="File"
            name="accountFile"
            fileName="${var:logDirectory}/${shortdate}/${event-properties:item=AccountFileName}.log"
            layout="${date:format=HH\:mm\:ss.ffff} | [${threadid}] | ${message}"
            encoding="utf-8"
            keepFileOpen="false" />
  </targets>

  <rules>
    <logger name="ApiRequestTrace" minlevel="Debug" writeTo="accountFile" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Debug" writeTo="console,systemFile" />
  </rules>
</nlog>
