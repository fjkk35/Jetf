<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_work_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textSize="@dimen/inbound_work_title_text_size"
        android:textColor="@color/jetf_ink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/work_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_panel"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/jetf_ink"
                tools:text="[新竹退件]" />

            <TextView
                android:id="@+id/text_sequence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/jetf_red"
                tools:text="流水號：AB0001" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_location"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_location_code"
            app:boxCollapsedPaddingTop="6dp">

            <com.example.jetfapp.ui.common.NoImeTextInputEditText
                android:id="@+id/edit_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:minHeight="@dimen/inbound_work_input_min_height"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/inbound_work_input_text_size"
                tools:text="A01-01" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_size"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_size"
            app:boxCollapsedPaddingTop="6dp">

            <com.example.jetfapp.ui.common.NoImeAutoCompleteTextView
                android:id="@+id/dropdown_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1"
                android:minHeight="@dimen/inbound_work_input_min_height"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/inbound_work_input_text_size"
                tools:text="小" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_tracking"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_tracking_no"
            app:boxCollapsedPaddingTop="6dp">

            <com.example.jetfapp.ui.common.NoImeTextInputEditText
                android:id="@+id/edit_tracking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="@dimen/inbound_work_input_min_height"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/inbound_work_input_text_size"
                tools:text="JETF0001" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_return_tracking"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_return_tracking_no"
            android:visibility="gone"
            app:boxCollapsedPaddingTop="6dp"
            tools:visibility="visible">

            <com.example.jetfapp.ui.common.NoImeTextInputEditText
                android:id="@+id/edit_return_tracking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="@dimen/inbound_work_input_min_height"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/inbound_work_input_text_size"
                tools:text="RET0001" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/text_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textSize="18sp"
            android:textColor="@color/jetf_ink"
            tools:text="儲位已自動鎖定，可開始掃描單號。" />

        <LinearLayout
            android:id="@+id/loading_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_submission"
                android:layout_width="24dp"
                android:layout_height="24dp" />

            <TextView
                android:id="@+id/text_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/message_submitting"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/jetf_ink" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
