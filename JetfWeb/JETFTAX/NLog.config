<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <targets>
    <!-- �D�n��x�ɮ� - ��UserId�M������� -->
    <target xsi:type="File" 
            name="userActionLog"
          fileName="${basedir}/Log/UserActions/${mdlc:userId:whenEmpty=Unknown}/${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception:format=tostring}"
          archiveFileName="${basedir}/Log/UserActions/${mdlc:userId:whenEmpty=Unknown}/archive/${shortdate}.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Sequence"
            maxArchiveFiles="30"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <!-- ���~��x�ɮ� -->
    <target xsi:type="File" 
            name="errorLog"
          fileName="${basedir}/Log/Errors/${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger} | UserId: ${mdlc:userId:whenEmpty=Unknown} | ${message} ${exception:format=tostring}"
          archiveFileName="${basedir}/Log/Errors/archive/${shortdate}.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Sequence"
            maxArchiveFiles="30"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />

    <!-- Console��X (�}�o�ɨϥ�) -->
    <target xsi:type="Console" 
            name="console"
            layout="${time} | ${level:uppercase=true} | ${logger:shortName=true} | UserId: ${mdlc:userId:whenEmpty=Unknown} | ${message}" />

    <!-- ��Ʈw��x (�O�d�{���\��) -->
    <target xsi:type="Database" 
            name="database"
            connectionString="${connectionstrings:DefaultConnection}">
      <commandText>
        INSERT INTO jetf.dbo.LOG_REC (DATADATE, FUN_INDEX, FUN_DATADATE, FUN_TYPE, FUN_FILENAME, FUN_MEMO, USER_ID, USER_IP, LOG_TIME)
        VALUES (CONVERT(date, GETDATE()), @logger, CONVERT(date, GETDATE()), @level, '', @message, @userId, @userIp, GETDATE())
      </commandText>
      <parameter name="@logger" layout="${logger}" />
      <parameter name="@level" layout="${level}" />
      <parameter name="@message" layout="${message}" />
      <parameter name="@userId" layout="${mdlc:userId:whenEmpty=Unknown}" />
      <parameter name="@userIp" layout="${mdlc:userIp:whenEmpty=Unknown}" />
    </target>
  </targets>

  <rules>
    <!-- �Ҧ���x�g�J�Τ�M���ɮ� -->
    <logger name="*" minlevel="Info" writeTo="userActionLog" />
    
    <!-- ���~��x�B�~�g�J���~�ɮ� -->
    <logger name="*" minlevel="Error" writeTo="errorLog" />
    
    <!-- �}�o��ҿ�X��Console -->
    <logger name="*" minlevel="Debug" writeTo="console">
      <when condition="environment('ASPNETCORE_ENVIRONMENT') == 'Development'" />
    </logger>

    <!-- ��Ʈw��x (�i��) -->
    <!-- <logger name="ActionLog" minlevel="Info" writeTo="database" /> -->
  </rules>
</nlog>