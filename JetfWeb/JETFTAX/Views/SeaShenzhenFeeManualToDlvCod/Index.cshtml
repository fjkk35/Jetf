@{
    ViewBag.Title = "代收金額人工調整";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .sea-shenzhen-manual-query-table-container {
        max-height: 620px;
        overflow: auto;
        border: 1px solid #dee2e6;
    }

        .sea-shenzhen-manual-query-table-container table {
            min-width: 900px;
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

        .sea-shenzhen-manual-query-table-container thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #343a40;
            color: #fff;
            white-space: nowrap;
        }

        .sea-shenzhen-manual-query-table-container td,
        .sea-shenzhen-manual-query-table-container th {
            padding: 8px;
            vertical-align: middle;
            border: 1px solid #dee2e6;
            white-space: normal;
            word-break: break-all;
        }

        .sea-shenzhen-manual-query-table-container tbody tr:nth-of-type(odd) {
            background-color: #f7f7f7;
        }

        .sea-shenzhen-manual-query-table-container tbody tr:hover {
            background-color: #eef5ff;
        }
</style>

<div ng-controller="SeaShenzhenFeeManualToDlvCodController">
    <span class="headtype">代收金額人工調整</span>
    <hr />

    <div class="containertype">
        <div class="card bg-light rounded p-4 mb-4" style="border:none;">
            <div class="row mb-3 align-items-center">
                <div class="form-group row col-lg-4 mb-0">
                    <label for="seaShenzhenManualTrackingNo" class="col-lg-4 col-form-label text-right">託運單號</label>
                    <div class="col-lg-8">
                        <input type="text"
                               id="seaShenzhenManualTrackingNo"
                               class="form-control"
                               ng-model="searchForm.trackingNo"
                               placeholder="請輸入託運單號" />
                    </div>
                </div>
                <div class="col-lg-8 text-right">
                    <button type="button" class="btn btn-primary" ng-click="search()" ng-disabled="loading || uploading">
                        <i class="fa fa-search"></i> 查詢
                    </button>
                    <button type="button" class="btn btn-secondary ml-2" ng-click="clearSearch()" ng-disabled="loading || uploading">
                        <i class="fa fa-eraser"></i> 清除
                    </button>
                    <button type="button" class="btn btn-info ml-2" ng-click="openUploadModal()" ng-disabled="loading || uploading">
                        <i class="fa fa-upload"></i> 上傳
                    </button>
                </div>
            </div>
        </div>

        <div ng-show="loading" class="text-center">
            <i class="fa fa-spinner fa-spin fa-3x"></i>
            <p>載入中...</p>
        </div>

        <div ng-show="isSearched && !loading">
            <div class="row mb-2">
                <div class="col-lg-6">
                    <div class="form-inline">
                        <label class="mr-2">每頁顯示</label>
                        <select class="form-control" ng-model="pageSize" ng-change="changePageSize()">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <label class="ml-2">筆</label>
                    </div>
                </div>
                <div class="col-lg-6 text-right">
                    <span>{{recordsInfo}}</span>
                </div>
            </div>

            <div class="sea-shenzhen-manual-query-table-container mt-3">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>序號</th>
                            <th>分提單號</th>
                            <th>代收金額</th>
                            <th>上傳時間</th>
                            <th>上傳人員</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="data.length === 0">
                            <td colspan="5" class="text-center">查無資料</td>
                        </tr>
                        <tr ng-repeat="item in data track by item.Id">
                            <td>{{(currentPage - 1) * parsePageSize() + $index + 1}}</td>
                            <td>{{ item.TrackingNo }}</td>
                            <td>{{ item.ToDlvCod }}</td>
                            <td>{{ item.CreatedTimeText }}</td>
                            <td>{{ item.CreatedUser }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="row mt-3" ng-show="totalPages > 1">
                <div class="col-lg-12">
                    <nav>
                        <ul class="pagination justify-content-center">
                            <li class="page-item" ng-class="{disabled: currentPage === 1}">
                                <a class="page-link" href="javascript:void(0)" ng-click="previousPage()">上一頁</a>
                            </li>
                            <li class="page-item" ng-repeat="page in getPages()" ng-class="{active: page === currentPage}">
                                <a class="page-link" href="javascript:void(0)" ng-click="changePage(page)">{{page}}</a>
                            </li>
                            <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                                <a class="page-link" href="javascript:void(0)" ng-click="nextPage()">下一頁</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <div class="modal fade" id="seaShenzhenFeeManualToDlvCodUploadModal" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">代收金額人工調整上傳</h5>
                        <button type="button" class="close" data-dismiss="modal">
                            <span>&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <input type="file" class="form-control" id="seaShenzhenFeeManualToDlvCodFileInput" accept=".xlsx" />
                        </div>
                        <div class="mb-3">
                            <a href="@Url.Action("DownloadTemplate", "SeaShenzhenFeeManualToDlvCod")" target="_blank">下載範例</a>
                        </div>
                        <div ng-if="uploadResult" class="mt-3">
                            <div class="alert" ng-class="{'alert-success': uploadResult.success, 'alert-danger': !uploadResult.success}">
                                {{ uploadResult.message }}
                            </div>
                        </div>
                        <div class="mt-3" ng-if="uploadFailData.length > 0">
                            <h5>上傳失敗明細（共 {{ uploadFailData.length }} 筆）</h5>
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th>Excel列號</th>
                                            <th>失敗欄位</th>
                                            <th>失敗原因</th>
                                            <th>分提單號</th>
                                            <th>物流貨號</th>
                                            <th>代收金額</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="item in uploadFailData" class="table-danger">
                                            <td>{{ item.RowNo }}</td>
                                            <td>{{ item.FailFieldName }}</td>
                                            <td>{{ item.FailReason }}</td>
                                            <td>{{ item.TrackingNo }}</td>
                                            <td>{{ item.DlvInv }}</td>
                                            <td>{{ item.ToDlvCodText }}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal" ng-disabled="uploading">取消</button>
                        <button type="button" class="btn btn-primary" ng-click="uploadFile()" ng-disabled="uploading">
                            <i class="fa fa-spinner fa-spin" ng-show="uploading"></i>
                            {{ uploading ? '上傳中...' : '上傳' }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
