@{
    ViewBag.Title = "代收金額人工調整";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="SeaShenzhenFeeManualToDlvCodController">
    <span class="headtype">代收金額人工調整</span>
    <hr />

    <div class="containertype">
        <div class="card bg-light rounded p-4 mb-4" style="border:none;">
            <div class="row">
                <div class="col-lg-12" style="margin-bottom:0.5rem;">
                    <label>選擇檔案</label>
                    <input type="file" id="seaShenzhenFeeManualToDlvCodFileInput" accept=".xlsx" class="form-control" />
                </div>
                <div class="col-lg-12" style="margin:0.5rem 0;">
                    <a href="@Url.Action("DownloadTemplate", "SeaShenzhenFeeManualToDlvCod")" target="_blank">下載範例</a>
                </div>
                <div class="col-lg-12" style="margin:0.5rem 0;">
                    <button type="button" class="btn btn-success confirmbtn" ng-click="uploadFile()" ng-disabled="uploading">
                        <i class="fas fa-upload"></i> {{ uploading ? '上傳中...' : '上傳' }}
                    </button>
                </div>
            </div>
        </div>

        <div class="loader loader-bar" ng-class="{'is-active': uploading}" data-rounded data-text="資料處理中"></div>

        <div class="col-lg-12" style="margin-top:1rem;" ng-if="uploadResult">
            <div class="alert" ng-class="{'alert-success': uploadResult.success, 'alert-danger': !uploadResult.success}">
                {{ uploadResult.message }}
            </div>
        </div>

        <div class="col-lg-12" style="margin-top:1rem;" ng-if="uploadFailData.length > 0">
            <h4>上傳失敗明細（共 {{ uploadFailData.length }} 筆）</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Excel列號</th>
                            <th>失敗欄位</th>
                            <th>失敗原因</th>
                            <th>分提單號</th>
                            <th>物流貨號</th>
                            <th>代收金額</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in uploadFailData" class="table-danger">
                            <td>{{ item.RowNo }}</td>
                            <td>{{ item.FailFieldName }}</td>
                            <td>{{ item.FailReason }}</td>
                            <td>{{ item.TrackingNo }}</td>
                            <td>{{ item.DlvInv }}</td>
                            <td>{{ item.ToDlvCodText }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
