@model JETFTAX.Models.CptStatusReport.CptStatusReportViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">CPT收單錯單狀況表</span>
<hr />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="DownloadFileForm" action="@Url.Action("", "")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.StartDate)
        @Html.TextBoxFor(m => m.StartDate, new { @class = "form-control" })~
        @Html.TextBoxFor(m => m.EndDate, new { @class = "form-control" })
    </div>

    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.DataTypeList)
        @Html.DropDownListFor(m => m.DataType, Model.DataTypeList, new { @class = "form-control" })
    </div>

    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.CptStatus)
        @Html.DropDownListFor(m => m.CptStatus, Model.CptStatusList, new { @class = "form-control" })
    </div>

    <div id="btntDownloadFile" type="button" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-download"></i> 下載</div>

    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</form>

@{
    <script>

        //日期
        $('#StartDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#EndDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#collapseWorkLoad').addClass("show");
        $('#CptStatusReport').addClass("active");

        $('#btntDownloadFile').click(function () {
            $('.loader').addClass("is-active");

            var postData = new FormData($('#DownloadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('CptStatusReport', 'GetExcel'),
                data: postData,
                cache: false,
                dataType: 'json',
                processData: false,
                //async: false,
                contentType: false,
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                + '&filename=' + data.fileName;
                            //window.location = path;
                            window.open(path);

                        }
                    }
                    file.outerHTML = file.outerHTML; //重置了file的outerHTML
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        })
    </script>

}
