@model JETFTAX.Models.CustWorkLoadReportViewModel

@{
    ViewBag.Title = "CustWorkLoadReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">空快客戶作業量報表</span>
<hr />
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="DownloadFileForm" action="@Url.Action("", "WorkLoad")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.sDate)
        @Html.TextBoxFor(m => m.sDate, new { @class = "form-control" })13：00　~　
        @Html.TextBoxFor(m => m.eDate, new { @class = "form-control" })12：59
    </div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.custId)
        @Html.DropDownListFor(m => m.custId, Model.ddlCustomerList, new { @class = "form-control" })
    </div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.custTypeId)
        @Html.DropDownListFor(m => m.custTypeId, Model.ddlCustomerTypeList, new { @class = "form-control" })
    </div>

    <div id="btntDownload" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem; "><i class="fas fa-download"></i> 下載</div>
    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</form>


<script>
        $('#collapseWorkLoad').addClass("show");
        $('#CustWorkLoadReport').addClass("active");

        //日期
        $('#sDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#eDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#btntDownload').click(function () {
            //$("#DownloadFileForm").submit();
            $('.loader').addClass("is-active");
            var postData = new FormData($('#DownloadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('EtlCustWorkLoad', 'CustWorkLoadReportExcel'),
                data: postData,
                cache: false,
                dataType: 'json',
                processData: false,
                //async: false,
                contentType: false,
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                + '&filename=' + data.fileName;
                            //window.location = path;
                            window.open(path);
                          
                        }
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            })
        })
</script>
