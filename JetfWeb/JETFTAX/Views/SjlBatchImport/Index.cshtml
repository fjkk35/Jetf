@{
    ViewBag.Title = "捷利托運資料上傳";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="SjlBatchImportController">
    <span class="headtype">捷利托運資料上傳</span>
    <hr />

    <div class="containertype">
        <div class="card bg-light rounded p-4 mb-4" style="border:none;">
            <div class="row">
                <div class="col-lg-12" style="margin-bottom:0.5rem;">
                    <label>選擇 Excel 檔案（可複選）</label>
                    <input type="file" id="fileInput" accept=".xlsx" class="form-control" multiple />
                </div>
                <div class="col-lg-12" style="margin:0.5rem 0;">
                    <a href='~/Download/DownloadExample?filePath=@AppDomain.CurrentDomain.BaseDirectory\Download\捷利托運資料上傳_範例.xlsx&fileName=捷利托運資料上傳_範例.xlsx' target='_blank'>下載範例</a>
                </div>
                <div class="col-lg-12" style="margin:0.5rem 0;">
                    <button type="button" class="btn btn-success confirmbtn" ng-click="uploadFile()" ng-disabled="uploading">
                        <i class="fas fa-upload"></i> {{ uploading ? '上傳中...' : '上傳' }}
                    </button>
                </div>
            </div>
        </div>

        <div class="loader loader-bar" ng-class="{'is-active': uploading}" data-rounded data-text="資料處理中"></div>

        <div class="col-lg-12" style="margin-top:1rem;" ng-if="uploadResult">
            <div class="alert" ng-class="{'alert-success': uploadResult.success, 'alert-danger': !uploadResult.success}">
                {{ uploadResult.message }}
            </div>
        </div>

        <div class="col-lg-12" style="margin-top:1rem;" ng-if="uploadFailData.length > 0">
            <h4>上傳失敗明細（共 {{ uploadFailData.length }} 筆）</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>檔案名稱</th>
                            <th>Excel列號</th>
                            <th>失敗欄位</th>
                            <th>失敗原因</th>
                            <th>運送編號</th>
                            <th>單據編號</th>
                            <th>編號</th>
                            <th>收件人</th>
                            <th>派送日</th>
                            <th>其他費用</th>
                            <th>代收</th>
                            <th>地址</th>
                            <th>品名</th>
                            <th>件數</th>
                            <th>材積</th>
                            <th>重量</th>
                            <th>收件人電話</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in uploadFailData" class="table-danger">
                            <td>{{ item.FileName }}</td>
                            <td>{{ item.RowNo }}</td>
                            <td>{{ item.FailFieldName }}</td>
                            <td>{{ item.FailReason }}</td>
                            <td>{{ item.JetfSerial }}</td>
                            <td>{{ item.BagNumber }}</td>
                            <td>{{ item.Seq }}</td>
                            <td>{{ item.Importer }}</td>
                            <td>{{ item.DeliveryDateText }}</td>
                            <td>{{ item.OtherFeeText }}</td>
                            <td>{{ item.CodText }}</td>
                            <td>{{ item.ImporterAddr }}</td>
                            <td>{{ item.ItemName }}</td>
                            <td>{{ item.QtyText }}</td>
                            <td>{{ item.VolumeText }}</td>
                            <td>{{ item.GwText }}</td>
                            <td>{{ item.ImporterPhone }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

