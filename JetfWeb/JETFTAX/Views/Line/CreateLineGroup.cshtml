@model JETFTAX.Models.LineGroupViewModel
@{
    ViewBag.Title = "CreateGroup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
@Scripts.Render("~/Scripts/lib/sweetalert.min.js")

@using (Html.BeginForm("CreateLineGroup", "Line", FormMethod.Post, new { id = "lineGroupForm" }))
{
    <span class="headtype">Line群組建立</span>
    <hr />
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.GroupId)
        @Html.TextBoxFor(m => m.GroupId)
    </div>
    <div class="col-lg-12">
        @Html.LabelFor(m => m.GroupName)
        @Html.TextBoxFor(m => m.GroupName)
    </div>
    <div class="col-lg-12">
        <div id="btntSearch" class="btn btn-success" onclick="$('#lineGroupForm').submit()" style="font-size: 1.2rem;"><i class="fas fa-search"></i> 新增</div>
    </div>


}

<script>
    $('#collapseLine').addClass("show");
    $('#CreateLineGroup').addClass("active");

    if ('@TempData["status"]' != '' )
    {
        if ('@TempData["status"]' == "success")
        {
                swal({
                    title:'@TempData["message"]',
                    icon: "success",
                });
        }
        else
        {
                swal({
                    title:'@TempData["message"]',
                    icon: 'error',
                });
        }
    }
</script>
