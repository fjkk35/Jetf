@{
    ViewBag.Title = "應收未收明細";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid receivable-page"
     ng-controller="ReceivableController"
     ng-init="init()">
    <span class="headtype">應收未收明細</span>
    <hr />

    <div class="card bg-light rounded p-4 mb-4" style="border:none">
        <div class="row align-items-center">
            <div class="form-group row col-xl-4 col-lg-6 mb-3">
                <label class="col-sm-2 col-form-label text-right">日期</label>
                <div class="col-sm-10 d-flex align-items-center">
                    <input type="text"
                           class="datepicker-input form-control"
                           ng-model="searchForm.outDateStart"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="startDatePopup.opened"
                           ng-click="openStartDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           required
                           placeholder="開始日期"
                           autocomplete="off" />
                    <span class="mx-2">~</span>
                    <input type="text"
                           class="datepicker-input form-control"
                           ng-model="searchForm.outDateEnd"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="endDatePopup.opened"
                           ng-click="openEndDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           required
                           placeholder="結束日期"
                           autocomplete="off" />
                </div>
            </div>

            <div class="form-group row col-xl-3 col-lg-6 mb-3">
                <label class="col-sm-3 col-form-label text-right">客戶</label>
                <div class="col-sm-9">
                    <reconciliation-customer-selector
                        options-url="@Url.Action("GetCustomerSelectionOptions", "Receivable")"
                        selected-customer-map="selectedCustomerMap"
                        disabled="loading">
                    </reconciliation-customer-selector>
                </div>
            </div>

            <div class="form-group row col-xl-2 col-lg-4 mb-3">
                <label class="col-sm-4 col-form-label text-right">狀態</label>
                <div class="col-sm-8">
                    <select class="form-control" ng-model="searchForm.status">
                        <option value="">全部</option>
                        <option value="1">已收回</option>
                        <option value="2">未收回</option>
                    </select>
                </div>
            </div>

            <div class="form-group row col-xl-3 col-lg-4 mb-3">
                <label class="col-sm-4 col-form-label text-right">區分</label>
                <div class="col-sm-8">
                    <select class="form-control" ng-model="searchForm.collectionType">
                        <option value="">全部</option>
                        <option value="1">跟廠商收</option>
                        <option value="2">跟派件收</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row align-items-center">
            <div class="form-group row col-xl-4 col-lg-6 mb-3">
                <label class="col-sm-2 col-form-label text-right">分提單號</label>
                <div class="col-sm-5">
                    <input type="text"
                           class="form-control"
                           ng-model="searchForm.trackingNo"
                           placeholder="請輸入分提單號"
                           autocomplete="off" />
                </div>
            </div>

            <div class="form-group row col-xl-3 col-lg-6 mb-3">
                <label class="col-sm-3 col-form-label text-right">物流貨號</label>
                <div class="col-sm-9">
                    <input type="text"
                           class="form-control"
                           ng-model="searchForm.dlvInv"
                           placeholder="請輸入物流貨號"
                           autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 text-right">
                <button type="button" class="btn btn-primary" ng-click="search()" ng-disabled="loading">
                    <i class="fa fa-search"></i> 查詢
                </button>
                <button type="button" class="btn btn-secondary ml-2" ng-click="clearSearch()" ng-disabled="loading">
                    <i class="fa fa-eraser"></i> 清除
                </button>
                <button type="button"
                        class="btn btn-success ml-2"
                        ng-click="exportExcel()"
                        ng-disabled="exporting || loading">
                    <i class="fa" ng-class="{'fa-spinner fa-spin': exporting, 'fa-download': !exporting}"></i>
                    {{exporting ? '匯出中...' : '下載Excel'}}
                </button>
            </div>
        </div>
    </div>

    <div ng-show="loading" class="text-center py-4">
        <i class="fa fa-spinner fa-spin fa-3x"></i>
        <p>載入中...</p>
    </div>

    <div ng-show="isSearched && !loading">
        <div class="row mb-2 align-items-center">
            <div class="col-md-6">
                <div class="form-inline">
                    <label class="mr-2">每頁顯示</label>
                    <select class="form-control" ng-model="pageSize" ng-change="changePageSize()">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                    <label class="ml-2">筆</label>
                </div>
            </div>
            <div class="col-md-6 text-right">
                <span>{{recordsInfo}}</span>
            </div>
        </div>

        <div class="table-responsive receivable-table-wrapper">
            <table class="table table-bordered table-striped table-hover receivable-table">
                <thead class="thead-dark">
                    <tr>
                        <th>序號</th>
                        <th>掛帳日</th>
                        <th>客戶銷帳日</th>
                        <th>物流銷帳日</th>
                        <th>資料來源</th>
                        <th>報關類別</th>
                        <th>客戶</th>
                        <th>出倉時間</th>
                        <th>分提單號</th>
                        <th>物流貨號</th>
                        <th>稅單號碼</th>
                        <th>代收小計</th>
                        <th>已收金額</th>
                        <th>未收金額</th>
                        <th>跟廠商收</th>
                        <th>跟派件收</th>
                        <th>捷豐支付</th>
                        <th>報關費</th>
                        <th>重派運費</th>
                        <th>到付款</th>
                        <th>手續費</th>
                        <th>未回收原因</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-if="rows.length === 0">
                        <td colspan="22" class="text-center">查無資料</td>
                    </tr>
                    <tr ng-repeat="row in rows track by row.Id">
                        <td class="text-center">{{(currentPage - 1) * pageSize + $index + 1}}</td>
                        <td>{{row.PostingDate}}</td>
                        <td>{{row.CustomerReconciliationDate}}</td>
                        <td>{{row.LogisticsReconciliationDate}}</td>
                        <td>{{row.Source}}</td>
                        <td>{{row.Type}}</td>
                        <td title="{{row.CustomerCode}}">{{row.CustomerName}}</td>
                        <td>{{row.OutDateTime}}</td>
                        <td>{{row.TrackingNo}}</td>
                        <td>{{row.DlvInv}}</td>
                        <td>{{row.TaxNumber}}</td>
                        <td class="text-right">{{row.CodSubtotal | number:0}}</td>
                        <td class="text-right">{{row.ReceivedAmount | number:0}}</td>
                        <td class="text-right">{{row.UnreceivedAmount | number:0}}</td>
                        <td class="text-right">{{row.CustomerCod | number:0}}</td>
                        <td class="text-right">{{row.TransCod | number:0}}</td>
                        <td>{{row.JetfPayment}}</td>
                        <td class="text-right">{{row.Ccfee | number:0}}</td>
                        <td>{{row.RedispatchFreight}}</td>
                        <td class="text-right">{{row.Cod | number:0}}</td>
                        <td class="text-right">{{row.Fee | number:0}}</td>
                        <td>{{row.UnreceivedReason}}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <nav class="mt-3" ng-if="totalPages > 1" aria-label="應收未收明細分頁">
            <ul class="pagination justify-content-center">
                <li class="page-item" ng-class="{disabled: currentPage === 1}">
                    <button type="button" class="page-link" ng-click="goToPage(1)">第一頁</button>
                </li>
                <li class="page-item" ng-class="{disabled: currentPage === 1}">
                    <button type="button" class="page-link" ng-click="previousPage()">上一頁</button>
                </li>
                <li class="page-item"
                    ng-repeat="page in getPageNumbers() track by page"
                    ng-class="{active: page === currentPage}">
                    <button type="button" class="page-link" ng-click="goToPage(page)">{{page}}</button>
                </li>
                <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                    <button type="button" class="page-link" ng-click="nextPage()">下一頁</button>
                </li>
                <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                    <button type="button" class="page-link" ng-click="goToPage(totalPages)">最後一頁</button>
                </li>
            </ul>
        </nav>
    </div>

</div>

<style>
    .receivable-page .receivable-table {
        min-width: 2450px;
        white-space: nowrap;
    }

    .receivable-page .receivable-table th,
    .receivable-page .receivable-table td {
        vertical-align: middle;
    }

    @@media (max-width: 767.98px) {
        .receivable-page .form-group label {
            text-align: left !important;
        }
    }
</style>
