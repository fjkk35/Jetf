@{
    ViewBag.Title = "批量查詢速派新遞物流貨號";
}

<div ng-controller="BatchSearchShenzhenCargoController" class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2>批量查詢速派新遞物流貨號</h2>
            <hr />
            <!-- 查詢區塊 -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title">分提單號</h3>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <div class="col-sm-8">
                                <textarea class="form-control" 
                                          ng-model="queryData.trackingNoList" 
                                          rows="10" 
                                          placeholder="請輸入分提單號"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-2 col-sm-10">
                                <button type="button" 
                                        class="btn btn-primary" 
                                        ng-click="search()" 
                                        ng-disabled="isLoading || !queryData.trackingNoList">
                                    <i class="fa fa-search"></i> 查詢
                                </button>
                                <button type="button" 
                                        class="btn btn-success" 
                                        ng-click="exportExcel()" 
                                        ng-disabled="isLoading || !queryData.trackingNoList">
                                    <i class="fa fa-file-excel-o"></i> 匯出 Excel
                                </button>
                                <button type="button" 
                                        class="btn btn-warning" 
                                        ng-click="clear()">
                                    <i class="fa fa-refresh"></i> 清除
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 載入中提示 -->
            <div class="text-center" ng-show="isLoading">
                <i class="fa fa-spinner fa-spin fa-3x"></i>
                <p>處理中，請稍候...</p>
            </div>

            <!-- 查詢結果區塊 -->
            <div class="col-md-6" ng-show="searchResults.length > 0 && !isLoading">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h3 class="panel-title">查詢結果（共 {{searchResults.length}} 筆）</h3>
                    </div>
                    <div class="panel-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th class="text-center" style="width: 80px;">序號</th>
                                        <th class="text-center">分提單號</th>
                                        <th class="text-center">速派新遞物流貨號</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in searchResults">
                                        <td class="text-center">{{$index + 1}}</td>
                                        <td>{{item.TrackingNo}}</td>
                                        <td>
                                            <span ng-if="item.DeliveryNo">{{item.DeliveryNo}}</span>
                                            <span ng-if="!item.DeliveryNo" class="text-muted">（查無資料）</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

