@model JETFTAX.Models.Cargo.ShenzhenCargoViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>DialogShenzhenCargo</title>
</head>
<body>
    <table>
        <thead>
            <tr>
                <th colspan="4" class="tablesort">速派新遞物流貨號</th>
            </tr>
        </thead>
        <tbody class="deliverycontent">
            <tr>
                <td>分提單號</td>
                <td>物流貨號</td>
            </tr>
            @{
                if (Model.List != null)
                {
                    for (int i = 0; i < Model.List.Count; i++)
                    {
                        <tr>
                            <td>@Model.List[i].TrackingNo</td>
                            <td>@Model.List[i].DeliveryNo</td>
                        </tr>
                    }

                    if (Model.List.Count == 0)
                    {
                        <tr>
                            <td colspan="2" style="text-align:center">無資料</td>
                        </tr>
                    }
                }

            }
        </tbody>
    </table>
</body>
</html>
