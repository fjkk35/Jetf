@model  JETFTAX.Models.SearchCargo2ViewModel
@{
    ViewBag.Title = "SearchCargo2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .radio-rdoSearchType {
        position: relative;
        display: inline-block;
        margin-right: 12px;
    }

        .radio-rdoSearchType input {
            vertical-align: middle;
            margin-top: -2px;
            margin-bottom: 1px;
            /* 前面三行程式碼是為了讓radio單選按鈕與文字對齊 */
            width: 20px;
            height: 20px;
            appearance: none; /*清楚預設樣式*/
            -webkit-appearance: none;
            opacity: 0;
            outline: none;
            /* 注意不能設定為display:none*/
        }

        .radio-rdoSearchType label {
            position: absolute;
            left: 0;
            top: 0;
            width: 20px;
            height: 20px;
            border: 1px solid #337ab7;
            border-radius: 100%;
        }

        .radio-rdoSearchType input:checked + label {
            background: #337ab7;
        }

            .radio-rdoSearchType input:checked + label::after {
                content: "";
                position: absolute;
                left: 8px;
                top: 2px;
                width: 5px;
                height: 12px;
                border-right: 1px solid #fff;
                border-bottom: 1px solid #fff;
                transform: rotate(45deg);
            }
</style>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<span class="headtype">貨況查詢</span>
<hr />
<form id="DownloadFileForm" action="@Url.Action("SearchCargo2", "Cargo")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.ddlSearchTypeList)
        @Html.DropDownListFor(m => m.searchType, Model.ddlSearchTypeList, new { @class = "form-control" })
        <input type="text" style="width:20%;" id="invoice" name="invoice" value="" />
        <div id="btntSearch" class="btn btn-success" style="font-size: 1.2rem;"><i class="fas fa-search"></i> 查詢</div>
    </div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;color:red">快捷鍵:Ctrl+(1~5)切換查詢類別</div>
    <div class="col-12 col-md-12 col-sm-12">
        <table id="cargoTable" style="width:100%;">
            <thead>
                <tr>
                    <th width="5%">明細</th>
                    <th width="8%">稅金作業日</th>
                    <th width="8%">倉儲類型</th>
                    <th width="8%">出倉日期</th>
                    <th width="15%">客戶名稱</th>
                    <th width="8%">主提單號</th>
                    <th width="8%">清關袋號</th>
                    <th width="8%">件數</th>
                    <th width="10%">物流貨號</th>
                    <th width="20%">品名</th>
                    @*<th></th>*@
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
            </tfoot>
        </table>
    </div>
    <div class="loader loader-bar" data-rounded data-text="查詢中"></div>

</form>

<!-- modal placeholder-->
<div id='myModal' class='modal fade in'>
    <div class="modal-dialog">
        <div class="modal-content" style="height:50rem; overflow-y:scroll">
            <b class="item-close" onclick="$('#myModal').modal('hide');">x</b>
            <div id='myModalContent'></div>
        </div>
    </div>
</div>

<script>


    $('#collapseSearch').addClass("show");
    $('#SearchCargo2').addClass("active");

    var getCargoList;
    $(function () {
        getCargoList =
            $('#cargoTable').DataTable({
                "processing": true,
                "serverSide": true,
                //pageLength: 10,
                //lengthMenu: [10, 25, 50, 100, 200],
                bSort: false,
                searching: false,
                paging: false,
                //searchDelay: 500, //延遲搜尋
                "ajax": {
                    "url": Router.action('Cargo', 'GetMerge_Originallist'),
                    "data": function (data) {
                        var obj = new Object();
                        obj.invoice = $('#invoice').val().trim();
                        obj.searchType = $('#searchType').val();
                        //obj.endDate = $('#endDate').val();
                        //obj.custno = $('#custno').val();
                        //obj.itemno = $('#itemno').val();
                        //obj.draw = data.draw;
                        //obj.start = data.start;
                        //obj.length = data.length;
                        //obj.order = data.order[0].dir; //升序或降序：隨滑鼠點擊發生變化
                        ////obj.sort = data.order[0].column == "2" ? "itemno" : data.order[0].column == "4" ? "ikindname" : "";//排序欄位
                        //obj.search = data.search.value;
                        return $.extend({}, {}, {
                            data: JSON.stringify(obj),
                        })
                    },
                    //"error": function (xhr, resp, text) {
                    //},
                    dataSrc: function (data) {
                        if (data.Redirect) {
                            window.location = Router.action('Account', 'Login');
                        }
                        return JSON.parse(data.data); //指定返回資料列的位置，該資料列為陣列形式
                    }
                },
                language: {
                    "url": "../Scripts/DataTables/Chinese-traditional.json",
                },
                //destroy: true,  //Cannot reinitialise DataTable,解决重新載入問題
                //data: data,
                //responsive: {
                //    details: {
                //        display: $.fn.dataTable.Responsive.display.modal({
                //            header: function (row) {
                //                var data = row.data();
                //                return '明細';
                //            }
                //        }),
                //        renderer: $.fn.dataTable.Responsive.renderer.tableAll({
                //            tableClass: 'ui table'
                //        })
                //    }
                //},
                columns: [
                    {
                        //參考https://dotblogs.com.tw/shadow/2018/04/03/065712
                        "data": "Id",//資料行繫結屬性
                        orderable: false, // 禁用排序
                        render: function (data, type, row, meta) {
                            if (data == "") {
                                return "";
                            }
                            else {
                                //row指的是資料列物件 data變數相等於row.sysid
                                return "<input type='button' class='btn btn-info' value='明細' onclick=showDialogCargo('" + data + "') />";
                            }
                        }
                    },
                    { "data": "F_DataDate" },
                    { "data": "I_DATA_TYPE" },
                    { "data": "Format_OUT_DATETIME" },
                    { "data": "CUSTOMER" },
                    { "data": "MAINNUMBER" },
                    { "data": "BL_NO" },
                    { "data": "PIECE" },
                    { "data": "DELIVERYNO" },
                    { "data": "ITEM_NAME" },
                    //{ "defaultContent": "" }
                ],
                columnDefs: [{
                    className: 'control',
                    orderable: false,
                    targets: -1
                },
                {
                    //targets: [0], //隱藏欄位
                    visible: false,
                    searchable: false
                }
                ]
            });


        $('body').keypress(function (e) {
            var key = window.event ? e.keyCode : e.which;
            if (key == 13) {
                getCargoList.draw();
                return false;
            }
        });
    });

    $('#btntSearch').click(function () {
        getCargoList.draw();
    })

    $(document).keydown(function (event) {
        if (event.ctrlKey && (event.keyCode === 49 || event.key === '1')) {
            event.preventDefault(); // 阻止切換分頁行為
            $('#searchType').prop('selectedIndex', 0);
        }
        else if (event.ctrlKey && (event.keyCode === 49 || event.key === '2')) {
            event.preventDefault(); // 阻止切換分頁行為
            $('#searchType').prop('selectedIndex', 1);
        }
        else if (event.ctrlKey && (event.keyCode === 49 || event.key === '3')) {
            event.preventDefault(); // 阻止切換分頁行為
            $('#searchType').prop('selectedIndex', 2);
        }
        else if (event.ctrlKey && (event.keyCode === 49 || event.key === '4')) {
            event.preventDefault(); // 阻止切換分頁行為
            $('#searchType').prop('selectedIndex', 3);
        }
        else if (event.ctrlKey && (event.keyCode === 49 || event.key === '5')) {
            event.preventDefault(); // 阻止切換分頁行為
            $('#searchType').prop('selectedIndex', 4);
        }
    });

    function showDialogCargo(id) {
        $('#myModalContent').load(Router.action('Cargo', 'DialogCargo2') + "?id=" + id, function () {
            $('#myModal').modal({
                /*backdrop: 'static',*/
                keyboard: true
            }, 'show');
            //bindFormCustomer(this);
        });
        return false;
    }


</script>
