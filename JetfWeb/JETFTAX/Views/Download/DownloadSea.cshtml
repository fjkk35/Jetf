@model JETFTAX.Models.DownloadSeaViewModel

@{
    ViewBag.Title = "Download";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">物流代收檔下載-海運</span>
<hr />
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="DownloadFileForm" action="@Url.Action("SeaExcel", "Download")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.date)
        @Html.TextBoxFor(m => m.date, new { @class = "form-control" })
    </div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.ddlTaxTypeList)
        @Html.DropDownListFor(m => m.taxType, Model.ddlTaxTypeList, new { @class = "form-control" })
    </div>
    <div id="btntDownload" type="submit" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-download"></i> 下載</div>
    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</form>
@{
    <script>
        $('#collapseUpload').addClass("show");
        $('#DownloadSea').addClass("active");

        //日期
        $('#date').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#btntDownload').click(function () {
            //$("#DownloadFileForm").submit();
            $('.loader').addClass("is-active");
            var postData = new FormData($('#DownloadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('Download', 'SeaExcel'),
                data: postData,
                cache: false,
                dataType: 'json',
                processData: false,
                //async: false,
                contentType: false,
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                + '&filename=' + data.fileName;
                            //window.location = path;
                            window.open(path);
                           
                        }
                    }
                }
            }).then(function () {
                    $.ajax({
                        type: "POST",
                        url: Router.action('Download', 'SeaSpecialDExcel'),
                        data: postData,
                        cache: false,
                        dataType: 'json',
                        processData: false,
                        //async: false,
                        contentType: false,
                        success: function (data) {
                            if (data.Redirect) {
                                window.location = Router.action('Account', 'Login');
                            }
                            else {
                                if (data.msg != "") {
                                    swal({
                                        title: data.msg,
                                        icon: "error"
                                    });
                                }
                                else if (data.fileName != "") {
                                    var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                        + '&filename=' + data.fileName;
                                    //window.location = path;
                                    window.open(path);
                                  
                                }
                            }
                        }
                })
            }).then(function () {
                    $.ajax({
                        type: "POST",
                        url: Router.action('Download', 'SeaErrorExcel'),
                        data: postData,
                        cache: false,
                        dataType: 'json',
                        processData: false,
                        //async: false,
                        contentType: false,
                        success: function (data) {
                            if (data.Redirect) {
                                window.location = Router.action('Account', 'Login');
                            }
                            else {
                                if (data.msg != "") {
                                    swal({
                                        title: data.msg,
                                        icon: "error"
                                    });
                                }
                                else if (data.fileName != "") {
                                    var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                        + '&filename=' + data.fileName;
                                    //window.location = path;
                                    window.open(path);
                                  
                                }
                            }
                        }
                    }).then(function () {
                        $('.loader').removeClass("is-active");
                    })
            })
        })

        //function sleep(time) {
        //    return new Promise((resolve) => setTimeout(resolve, time));
        //}
</script>

}
