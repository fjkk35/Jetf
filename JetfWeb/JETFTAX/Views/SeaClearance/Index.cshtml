@{
    ViewBag.Title = "UploadFile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="SeaClearanceController">
    <span class="headtype">海快後段報關系統</span>
    <hr />

    <!-- 查詢條件區域 -->
    <div class="card bg-light rounded p-4 mb-4" style="border:none">
        <div class="row mb-3 align-items-center">
            <!-- 分提單號 -->
            <div class="form-group row col-lg-3 mb-0">
                <label for="trackingNo" class="col-lg-4 col-form-label text-right">分提單號</label>
                <div class="col-lg-8">
                    <input type="text" 
                           id="trackingNo" 
                           class="form-control" 
                           placeholder="請輸入分提單號" 
                           ng-model="searchForm.trackingNo"
                           ng-keypress="$event.keyCode == 13 && search()" />
                </div>
            </div>

            <!-- 客戶 -->
            <div class="form-group row col-lg-3 mb-0">
                <label for="customerOption" class="col-lg-4 col-form-label text-right">客戶</label>
                <div class="col-lg-8">
                    <select id="customerOption" 
                            class="form-control" 
                            ng-model="searchForm.customerCode"
                            style="max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">
                        <option value="">請選擇客戶</option>
                        <option ng-repeat="customer in customers" value="{{customer.Value}}" title="{{customer.Text}}">{{customer.Text}}</option>
                    </select>
                </div>
            </div>

            <!-- 倉別 -->
            <div class="form-group row col-lg-3 mb-0">
                <label for="typeOption" class="col-lg-4 col-form-label text-right">倉別</label>
                <div class="col-lg-8">
                    <select id="typeOption" 
                            class="form-control" 
                            ng-model="searchForm.type">
                        <option value="">請選擇倉別</option>
                        <option ng-repeat="type in types" value="{{type.Value}}">{{type.Text}}</option>
                    </select>
                </div>
            </div>

            <!-- 報關方式 -->
            <div class="form-group row col-lg-3 mb-0">
                <label for="postEntryOption" class="col-lg-4 col-form-label text-right">報關方式</label>
                <div class="col-lg-8">
                    <select id="postEntryOption" 
                            class="form-control" 
                            ng-model="searchForm.postEntry">
                        <option value="">請選擇報關方式</option>
                        <option ng-repeat="entry in postEntries" value="{{entry.Value}}">{{entry.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <!-- 步驟 -->
            <div class="form-group row col-lg-3 mb-0">
                <label for="stepOption" class="col-lg-4 col-form-label text-right">步驟</label>
                <div class="col-lg-8">
                    <select id="stepOption"
                            class="form-control"
                            ng-model="searchForm.stepId"
                            style="max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">
                        <option value="">請選擇步驟</option>
                        <option ng-repeat="step in steps" value="{{step.Id}}" title="{{step.StepName}}">{{step.StepName}}</option>
                    </select>
                </div>
            </div>

            <!-- 異常狀態 -->
            <div class="form-group row col-lg-3 mb-0">
                <label for="abnormalStateOption" class="col-lg-4 col-form-label text-right">異常狀態</label>
                <div class="col-lg-8">
                    <select id="abnormalStateOption"
                            class="form-control"
                            ng-model="searchForm.abnormalStateId"
                            style="max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;">
                        <option value="">請選擇異常狀態</option>
                        <option ng-repeat="abnormalState in abnormalStates" value="{{abnormalState.Id}}" title="{{abnormalState.AbnormalStateName}}">{{abnormalState.AbnormalStateName}}</option>
                    </select>
                </div>
            </div>

            <!-- 報單號碼 -->
            <div class="form-group row  col-lg-3 mb-0">
                <label for="declNo" class="col-lg-4 col-form-label text-right">報單號碼</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="declNo"
                           class="form-control"
                           placeholder="請輸入報單號碼"
                           ng-model="searchForm.declNo"
                           ng-keypress="$event.keyCode == 13 && search()" />
                </div>
            </div>

            <!-- 原單申報人 -->
            <div class="form-group row col-lg-3 mb-0">
                <label for="importer" class="col-lg-4 col-form-label text-right">原單申報人</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="importer"
                           class="form-control"
                           placeholder="請輸入申報人"
                           ng-model="searchForm.importer"
                           ng-keypress="$event.keyCode == 13 && search()" />
                </div>
            </div>
        </div>

        <!-- 按鈕 -->
        <div class="row">
            <div class="col-lg-12 text-right pt-2">
                <button type="button" 
                        class="btn btn-primary mr-2" 
                        style="font-size: 1.2rem;" 
                        ng-click="search()"
                        ng-disabled="loading">
                    <i class="fas fa-search"></i> 查詢
                </button>
                <button type="button" 
                        class="btn btn-secondary mr-2" 
                        style="font-size: 1.2rem;" 
                        ng-click="clearSearch()">
                    <i class="fas fa-eraser"></i> 清除
                </button>
                <button type="button" 
                        class="btn btn-success" 
                        style="font-size: 1.2rem;" 
                        ng-click="exportExcel()"
                        ng-disabled="loading">
                    <i class="fas fa-file-export"></i> 匯出
                </button>
            </div>
        </div>
        <hr />
    </div>

    <!-- 查詢結果區域 -->
    <div class="col-12" style="margin-top: 20px;">
        <div ng-show="isSearched">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center">
                    <span class="mr-2">每頁顯示：</span>
                    <select class="form-control form-control-sm" 
                            style="width: 80px;" 
                            ng-model="pageSize" 
                            ng-change="changePageSize()">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span class="ml-3">{{recordsInfo}}</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>日期</th>
                            <th>步驟</th>
                            <th>倉別</th>
                            <th>報關方式</th>
                            <th>客戶名稱</th>
                            <th>主提單號</th>
                            <th>分提單號</th>
                            <th>報單號碼</th>
                            <th>原單申報人</th>
                            <th>件數</th>
                            <th>物流貨號</th>
                            <th>出倉日期</th>
                            <th>品名</th>
                            <th>明細</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="loading">
                            <td colspan="9" class="text-center">
                                <i class="fas fa-spinner fa-spin"></i> 載入中...
                            </td>
                        </tr>
                        <tr ng-if="!loading && data.length === 0">
                            <td colspan="9" class="text-center">查無資料</td>
                        </tr>
                        <tr ng-repeat="item in data" ng-if="!loading">
                            <td>{{item.DataDate || ''}}</td>
                            <td>{{item.StepName || ''}}</td>
                            <td>{{item.Modifyby || ''}}</td>
                            <td>{{item.Post_Entry || ''}}</td>
                            <td>{{item.Cust_Name || ''}}</td>
                            <td>{{item.MainNumber || ''}}</td>
                            <td>{{item.TrackingNo || ''}}</td>
                            <td style="white-space: pre">{{item.DeclNo || ''}}</td>
                            <td>{{item.Importer || ''}}</td>
                            <td>{{item.Piece || ''}}</td>
                            <td>{{item.Jetf_Serial || ''}}</td>
                            <td>{{item.SignOutTime | customDate}}</td>
                            <td>{{item.Item_Name || ''}}</td>
                            <td>
                                <button class="btn btn-info" ng-click="openDetail(item.Id)">明細</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- 分頁控制項 -->
            <div class="d-flex justify-content-center mt-3" ng-if="totalPages > 1">
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item" ng-class="{disabled: currentPage === 1}">
                            <a class="page-link" href="javascript:void(0)" ng-click="goToPage(1)">第一頁</a>
                        </li>
                        <li class="page-item" ng-class="{disabled: currentPage === 1}">
                            <a class="page-link" href="javascript:void(0)" ng-click="previousPage()">上一頁</a>
                        </li>
                        <li class="page-item" 
                            ng-repeat="page in getPageNumbers()" 
                            ng-class="{active: page === currentPage}">
                            <a class="page-link" href="javascript:void(0)" ng-click="goToPage(page)">{{page}}</a>
                        </li>
                        <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                            <a class="page-link" href="javascript:void(0)" ng-click="nextPage()">下一頁</a>
                        </li>
                        <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                            <a class="page-link" href="javascript:void(0)" ng-click="goToPage(totalPages)">最後一頁</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

        <!-- 無資料提示 -->
        <div ng-show="!isSearched" style="text-align: center; padding: 20px;">
            <h5>請輸入查詢條件後點擊查詢</h5>
        </div>
    </div>

    <!-- 載入指示器 -->
    <div class="loader loader-bar" ng-class="{'is-active': loading}" data-rounded data-text="處理中"></div>
</div>