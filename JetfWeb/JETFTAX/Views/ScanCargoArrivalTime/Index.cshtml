@model JETFTAX.Models.ScanCargoArrivalTime.ScanCargoArrivalTimeViewModel
@{
    ViewBag.Title = "ScanCargoCustomerDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Styles.Render("~/Scripts/lib/DateTimePicker/jquery-ui.css")
@Styles.Render("~/Scripts/lib/DateTimePicker/jquery-ui-timepicker-addon.css")

<span class="headtype">輸入外車交倉時間</span>
<hr />
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="form" action="@Url.Action("Index", "ScanCargoArrivalTime")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.SDate)
        @Html.TextBoxFor(m => m.SDate, new { @class = "form-control from-date-picker", @readonly = "readonly" })~
        @Html.TextBoxFor(m => m.EDate, new { @class = "form-control from-date-picker", @readonly = "readonly" })
    </div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.DataType)
        @Html.DropDownListFor(m => m.DataType, Model.DataTypeList, new { @class = "form-control" })
    </div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.Trans)
        @Html.DropDownListFor(m => m.Trans, Model.TransList, new { @class = "form-control" })
    </div>
    <div id="btntSearch" type="submit" class="btn btn-success col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-search"></i> 查詢</div>
    <div class="loader loader-bar" data-rounded data-text="查詢中"></div>

    <div class="col-12 col-md-12 col-sm-12">
        <table id="customerTable" class="hidden" style="width:100%;">
            <thead>
                <tr style="background-color: #FFF;">
                    <th>派件公司</th>
                    <th>件數</th>
                    <th>已交艙時間件數</th>
                    <th>查詢時間</th>
                    <th>查詢人員</th>
                    <th>交艙時間</th>
                    <th>更新</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
            </tfoot>
        </table>
    </div>
</form>

@Scripts.Render("~/Scripts/lib/DateTimePicker/jquery-ui.js")
@Scripts.Render("~/Scripts/lib/DateTimePicker/jquery-ui-sliderAccess.js")
@Scripts.Render("~/Scripts/lib/DateTimePicker/jquery-ui-timepicker-addon.js")
@Scripts.Render("~/Scripts/lib/DateTimePicker/lang/zh-tw.js")
@{

    <script>
        $('#collapseCCLWork').addClass("show");
        $('#ScanCargoArrivalTime').addClass("active");

        $('.from-date-picker').datetimepicker({
            dateFormat: 'yy-mm-dd',
            timeFormat: 'HH:mm',
            controlType: 'select',
            oneLine: true,
            closeText: "關閉",
            timeText: "時間",
        });

        $('#btntSearch').click(function (e) {
            e.preventDefault();

            search();
        });

        var dataTable;
        function search() {

            $('.loader').addClass("is-active");

            let param = new Object();
            param.SDate = $('#SDate').val();
            param.EDate = $('#EDate').val();
            param.Trans = $('#Trans').val();
            param.DataType = $('#DataType').val();

            $.ajax({
                url: Router.action('ScanCargoArrivalTime', 'Index'),
                type: "POST",   //用POST的方式
                dataType: "json",   //response的資料格式
                data: { "vm": param },
                //async: false,
                success: function (response) {
                    let result = JSON.parse(response); // 解析 AJAX 响应
                    if (result.status != "success") {
                        $('#customerTable').addClass('hidden');

                        swal({
                            title: result.msg,
                            icon: "error"
                        });
                    }
                    else {
                        $('#customerTable').removeClass('hidden');

                        //console.log(response);
                        //datatable更多Responsive用法請參考
                        //https://datatables.net/extensions/responsive/examples/

                        //此設定參考於這篇
                        //datatable套件參考網址
                        //https://datatables.net/extensions/responsive/examples/child-rows/right-column.html

                        let data = result.ReturnObject;

                        dataTable = $('#customerTable').DataTable({
                            ordering: false,
                            paging: false,
                            language: {
                                "url": "../Scripts/DataTables/Chinese-traditional.json",
                            },
                            destroy: true,  //Cannot reinitialise DataTable,解决重新載入問題
                            data: data,
                            responsive: {
                                details: {
                                    type: 'column',
                                    target: -1
                                }
                            },
                            columns: [
                                { "data": "TransName" },
                                { "data": "UploadTimeCount" },
                                { "data": "ArrivalTimeCount" },
                                { "data": "SearchTime" },
                                { "data": "SearchOpe" },
                                {
                                    orderable: false, // 禁用排序
                                    render: function (data, type, row, meta) {
                                        return `<input type='text' id='arrivalTime${meta.row}' />`;
                                    }
                                },
                                {
                                    orderable: false, // 禁用排序
                                    render: function (data, type, row, meta) {
                                        return `<input type='button' value='修改' onclick="edit('${meta.row}','${row.TransName}','${row.SearchTime}','${row.SearchOpe}')" />`;
                                    }
                                },
                                { "defaultContent": "" }
                            ],
                            columnDefs: [{
                                className: 'control',
                                orderable: false,
                                targets: -1
                            },
                            {
                                visible: false,
                                searchable: false
                            }
                            ]
                        });
                        new $.fn.dataTable.FixedHeader($('#customerTable').DataTable());
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        }

        function edit(rowIndex, transName, searchTime, searchOpe)
        {
            let arrivalTime = $(`#arrivalTime${rowIndex}`).val();

            $.ajax({
                url: Router.action('ScanCargoArrivalTime', 'UpdateScanCargoArrivalTime'),
                type: "POST",   //用POST的方式
                dataType: "json",   //response的資料格式
                data: { "arrivalTime": arrivalTime, "transName": transName, "searchTime": searchTime, "searchOpe": searchOpe, },
                //async: false,
                success: function (response) {
                    var result = JSON.parse(response); 

                    if (result.status == "success") {
                        let rowData = dataTable.row(rowIndex).data();
                        rowData.ArrivalTimeCount = rowData.UploadTimeCount;
                        dataTable.row(rowIndex).data(rowData).draw();

                        swal({
                            title: result.msg,
                            icon: "success"
                        });
                    }
                    else {
                        swal({
                            title: result.msg,
                            icon: "error"
                        });
                    }
                
                }
            });

          

        }
    </script>

}


