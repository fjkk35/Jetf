@model JETFTAX.Models.TransferBagReport.TransferBagReportViewModel
@{
    ViewBag.Title = "ScanCargoCustomerDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Styles.Render("~/Scripts/lib/DateTimePicker/jquery-ui.css")
@Styles.Render("~/Scripts/lib/DateTimePicker/jquery-ui-timepicker-addon.css")

<span class="headtype">接駁袋數統計表</span>
<hr />
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="DownloadFileForm" target="_blank" action="@Url.Action("", "")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.StartDate)
        @Html.TextBoxFor(m => m.StartDate, new { @class = "form-control from-date-picker", @readonly = "readonly" })~
        @Html.TextBoxFor(m => m.EndDate, new { @class = "form-control from-date-picker", @readonly = "readonly" })
    </div>
    <div id="btntDownload" type="submit" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-download"></i> 下載</div>
    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</form>

@Scripts.Render("~/Scripts/lib/DateTimePicker/jquery-ui.js")
@Scripts.Render("~/Scripts/lib/DateTimePicker/jquery-ui-sliderAccess.js")
@Scripts.Render("~/Scripts/lib/DateTimePicker/jquery-ui-timepicker-addon.js")
@Scripts.Render("~/Scripts/lib/DateTimePicker/lang/zh-tw.js")
@{

    <script>
        $('#collapseCCLWork').addClass("show");
        $('#TransferBagReport').addClass("active");

        $('.from-date-picker').datetimepicker({
            dateFormat: 'yy-mm-dd',
            timeFormat: 'HH:mm:ss',
            controlType: 'select',
            oneLine: true,
            closeText: "關閉",
            timeText: "時間",
        });

        $('#btntDownload').click(function () {
            $('.loader').addClass("is-active");
            var postData = new FormData($('#DownloadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('TransferBagReport', 'Excel'),
                data: postData,
                cache: false,
                dataType: 'json',
                processData: false,
                //async: false,
                contentType: false,
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                + '&filename=' + data.fileName;
                            //window.location = path;
                            window.open(path);

                        }
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            })
        })

    </script>

}


