@{
    ViewBag.Title = "報驗行建檔";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="CustomsBrokerController">
    <span class="headtype">報驗行建檔</span>
    <hr />

    <style>
        .category-badge { font-size: 1rem; padding: 0.55rem 0.85rem; font-weight: 500; }
        #customsBrokerTable { table-layout: fixed; width:100%; }
        .truncate-cell { display:flex; align-items:center; }
        .truncate-cell .text { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .truncate-cell.expanded .text { white-space:normal; overflow:visible; word-break:break-all; }
        .truncate-cell .expand-btn { margin-left:4px; font-size:11px; line-height:1; padding:2px 4px; }
    </style>

    <!-- 類別說明區域 -->
    <div class="alert alert-info mb-4" role="alert">
        <h6 class="mb-3" style="font-weight:600;">
            <i class="fas fa-info-circle"></i> 建檔類別說明
        </h6>
        <p class="mb-1"><strong>建檔類別請依照以下資料輸入</strong></p>
        <p class="mb-2">非以下類別，請自行輸入類別名稱。例：醫療器材、刀械、中藥材等。</p>
        <div class="row">
            <div class="col-md-12">
                <span class="badge badge-light mr-1 mb-1 category-badge">食品(台北)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">食品(高雄)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">食品容器(台北)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">食品容器(高雄)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">玩具</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">電器</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">資訊產品</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">輪胎</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">紡織品</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">化工類</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">嬰幼兒服飾</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">兒童雨衣</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">感熱紙</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">商品免驗通知書</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">玩具符合性聲明</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">品目查詢</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">外包材檢疫(台北)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">外包材檢疫(高雄)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">植物檢疫(台北)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">植物檢疫(高雄)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">免檢疫確認(台北)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">免檢疫確認(高雄)</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">NCC線上審核</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">補產地標</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">寢具備查文件</span>
                <span class="badge badge-light mr-1 mb-1 category-badge">機械設備判定</span>
            </div>
        </div>
    </div>

    <!-- 新增/編輯報驗公司 Modal -->
    <div class="modal fade" id="customsBrokerModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ modalTitle }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="customsBrokerForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-md-4 col-form-label text-right">公司名稱 <span class="text-danger">*</span></label>
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" ng-model="editModel.Name" required maxlength="100" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-md-4 col-form-label text-right">港區</label>
                                    <div class="col-md-8">
                                        <select class="form-control" ng-model="editModel.PortArea">
                                            <option value="">請選擇港區</option>
                                            <option ng-repeat="item in portAreaOptions" value="{{ item.Value }}">{{ item.Text }}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-primary" ng-click="saveCustomsBroker()" ng-disabled="loading">
                        <i class="fas fa-save"></i> 儲存
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 新增/編輯聯絡人 Modal -->
    <div class="modal fade" id="contactModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ contactModalTitle }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="contactForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-md-4 col-form-label text-right">報驗公司 <span class="text-danger">*</span></label>
                                    <div class="col-md-8">
                                        <select class="form-control" ng-model="contactModel.CustomsBrokerId" ng-disabled="contactModel.Id > 0" required>
                                            <option value="0">請選擇報驗公司</option>
                                            <option ng-repeat="item in customsBrokerOptions" ng-value="item.Value.toString()">{{ item.Text }}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-md-4 col-form-label text-right">聯絡人 <span class="text-danger">*</span></label>
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" ng-model="contactModel.ContactPerson" required/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-md-4 col-form-label text-right">電子郵件</label>
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" ng-model="contactModel.Email" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-md-4 col-form-label text-right">電話</label>
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" ng-model="contactModel.Phone" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group row">
                                    <label class="col-md-2 col-form-label text-right">類別</label>
                                    <div class="col-md-10">
                                        <input type="text" class="form-control" ng-model="contactModel.Category" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-primary" ng-click="saveContact()" ng-disabled="loading">
                        <i class="fas fa-save"></i> 儲存
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 查詢條件區域 -->
    <div class="card bg-light rounded p-4 mb-4" style="border:none">
        <div class="row mb-3 align-items-center">
            <!-- 公司名稱 -->
            <div class="form-group row col-lg-3 mb-0">
                <label class="col-lg-4 col-form-label text-right">公司名稱</label>
                <div class="col-lg-8">
                    <input type="text" ng-model="searchParams.Name" class="form-control" placeholder="請輸入公司名稱" ng-keypress="$event.which === 13 && performSearch()" />
                </div>
            </div>

            <!-- 聯絡人 -->
            <div class="form-group row col-lg-3 mb-0">
                <label class="col-lg-4 col-form-label text-right">聯絡人</label>
                <div class="col-lg-8">
                    <input type="text" ng-model="searchParams.ContactPerson" class="form-control" placeholder="請輸入聯絡人" ng-keypress="$event.which === 13 && performSearch()" />
                </div>
            </div>

            <!-- 港區 -->
            <div class="form-group row col-lg-3 mb-0">
                <label class="col-lg-4 col-form-label text-right">港區</label>
                <div class="col-lg-8">
                    <select ng-model="searchParams.PortArea" class="form-control">
                        <option value="">請選擇港區</option>
                        <option ng-repeat="item in portAreaOptions" value="{{ item.Value }}">{{ item.Text }}</option>
                    </select>
                </div>
            </div>

            <!-- 類別 -->
            <div class="form-group row col-lg-3 mb-0">
                <label class="col-lg-4 col-form-label text-right">類別</label>
                <div class="col-lg-8">
                    <input type="text" ng-model="searchParams.Category" class="form-control" placeholder="請輸入類別" ng-keypress="$event.which === 13 && performSearch()" />
                </div>
            </div>
        </div>

        <!-- 按鈕 -->
        <div class="row">
            <div class="col-lg-12 text-right pt-2">
                <button type="button" class="btn btn-primary mr-2" style="font-size: 1.2rem;" ng-click="performSearch()" ng-disabled="loading">
                    <i class="fas fa-search"></i> 查詢
                </button>
                <button type="button" class="btn btn-secondary mr-2" style="font-size: 1.2rem;" ng-click="clearSearch()">
                    <i class="fas fa-eraser"></i> 清除
                </button>
                <button type="button" class="btn btn-success mr-2" style="font-size: 1.2rem;" ng-click="showAddModal()">
                    <i class="fas fa-plus"></i> 新增公司
                </button>
                <button type="button" class="btn btn-info" style="font-size: 1.2rem;" ng-click="showAddContactModal()">
                    <i class="fas fa-user-plus"></i> 新增聯絡人
                </button>
            </div>
        </div>
        <hr />
    </div>

    <!-- 查詢結果區域 -->
    <div class="col-12" style="margin-top: 20px;">
        <div ng-show="isSearched">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center">
                    <span class="mr-2">每頁顯示：</span>
                    <select ng-model="pageSize" ng-change="changePageSize()" class="form-control form-control-sm" style="width: 80px;">
                        <option ng-repeat="size in pageSizeOptions" ng-value="size">{{ size }}</option>
                    </select>
                    <span class="ml-3">{{ getRecordsInfo() }}</span>
                </div>
            </div>

            <div class="table-responsive">
                <table id="customsBrokerTable" class="table table-striped table-bordered">
                    <colgroup>
                        <col style="width:10%" />
                        <col style="width:10%" />
                        <col style="width:5%" />
                        <col style="width:16%" />
                        <col style="width:10%" />
                        <col style="width:20%" />
                        <col style="width:6%" />
                        <col style="width:6%" />
                        <col style="width:9%" />
                        <col style="width:8%" />
                    </colgroup>
                    <thead class="thead-dark">
                        <tr>
                            <th>公司名稱</th>
                            <th>聯絡人</th>
                            <th>港區</th>
                            <th>電子郵件</th>
                            <th>電話</th>
                            <th>類別</th>
                            <th>更新時間</th>
                            <th>更新人員</th>
                            <th>編輯報驗公司</th>
                            <th>編輯聯絡人</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="dataList.length === 0">
                            <td colspan="9" class="text-center">查無資料</td>
                        </tr>
                        <tr ng-repeat="item in dataList" ng-init="setupTruncateButtons()">
                            <td>{{ item.Name || '' }}</td>
                            <td>{{ item.ContactPerson || '' }}</td>
                            <td>{{ item.PortArea || '' }}</td>
                            <td>
                                <div class="truncate-cell" title="{{ item.Email || '' }}">
                                    <span class="text">{{ item.Email || '' }}</span>
                                    <button type="button" class="btn btn-link expand-btn p-0" style="display:none;" ng-click="toggleExpand($event)">展開</button>
                                </div>
                            </td>
                            <td>{{ item.Phone || '' }}</td>
                            <td>
                                <div class="truncate-cell" title="{{ item.Category || '' }}">
                                    <span class="text">{{ item.Category || '' }}</span>
                                    <button type="button" class="btn btn-link expand-btn p-0" style="display:none;" ng-click="toggleExpand($event)">展開</button>
                                </div>
                            </td>
                            <td>{{ formatDate(item.UpdateDateTime) }}</td>
                            <td>{{ item.UpdateOperator || '' }}</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-warning mr-1 mb-1" ng-click="editCustomsBroker(item.Id)" title="編輯報驗公司">
                                    <i class="fas fa-edit"></i> 編輯
                                </button>
                                <button type="button" class="btn btn-sm btn-danger mr-1 mb-1" ng-click="deleteCustomsBroker(item.Id, item.Name)" title="刪除報驗公司">
                                    <i class="fas fa-trash"></i> 刪除
                                </button>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-info mr-1 mb-1" ng-click="editContact(item.ContactId)" ng-if="item.ContactId" title="編輯聯絡人">
                                    <i class="fas fa-user-edit"></i> 編輯
                                </button>
                                <button type="button" class="btn btn-sm btn-secondary mb-1" ng-click="deleteContact(item.ContactId, item.ContactPerson)" ng-if="item.ContactId" title="刪除聯絡人">
                                    <i class="fas fa-user-times"></i> 刪除
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- twbs-pagination 分頁控制項 -->
            <div class="d-flex justify-content-center mt-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination" id="pagination-twbs"></ul>
                </nav>
            </div>
        </div>

        <!-- 無資料提示 -->
        <div ng-show="!isSearched" style="text-align: center; padding: 20px;">
            <h5>查無資料</h5>
            <p>請調整查詢條件後重新查詢</p>
        </div>
    </div>

    <!-- 載入指示器 -->
    <div class="loader loader-bar" ng-class="{'is-active': loading}" data-rounded data-text="處理中"></div>
</div>

