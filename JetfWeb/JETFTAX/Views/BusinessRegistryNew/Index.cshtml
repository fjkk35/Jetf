
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #table tbody tr:hover {
        background-color: #e6ffe6;
        cursor: pointer;
    }
</style>

<script type="text/x-jquery-tmpl" id="businessRegistryNewTmpl">
    <tr>
        <td class="text-sm-right">${Business_Accounting_NO}</td>
        <td class="text-sm-right">${Company_Name}</td>
        <td class="text-sm-right">${Company_Status_Desc}</td>
        <td class="text-sm-right">${Revoke_App_Date}</td>
    </tr>
</script>

<span class="headtype">新營業登記</span>
<hr />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="DownloadFileForm" action="@Url.Action("", "")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:1.5rem;">
        <a href="https://data.gcis.nat.gov.tw/od/datacategory">商工行政資料開放平台</a>
    </div>
    <label style="margin:0.5rem;">統一編號:</label>
    <div style="margin:0.5rem;">
        <div style="padding-right:2rem;float:left;">
            <div>
                <textarea id="txtBusinessId" style="height:300px"></textarea>
            </div>
        </div>
        <div>
            <div id="btntSearch" class="btn btn-success" style="font-size: 1.2rem;"><i class="fas fa-search"></i> 查詢</div>
            <div id="btntDownloadFile" type="button" class="btn btn-primary confirmbtn" style="font-size: 1.2rem;"><i class="fas fa-download"></i> 下載</div>
        </div>
    </div>

    <div class="loader loader-bar" data-rounded data-text="執行中"></div>
</form>

<div class="col-12">
    <table id="table" style="color:black;" hidden class="dataTable no-footer dtr-column" border="1">
        <thead>
            <tr>
                <th>統一編號</th>
                <th>營業人名稱</th>
                <th>狀態</th>
                <th>核准解散日期</th>
            </tr>
        </thead>
        <tbody id="tbody">

        </tbody>
    </table>
</div>

@{
    <script>
        $('#collapseSearch').addClass("show");
        $('#BusinessRegistryNew').addClass("active");

        $("#btntSearch").click(function () {
            let businessId = $('#txtBusinessId').val();
            if (businessId == "") {
                swal({
                    title: "請輸入統一編號",
                    icon: "error"
                });
                return;
            }

            $('.loader').addClass("is-active");

            $.ajax({
                type: "POST",
                url: Router.action('BusinessRegistryNew', 'Search'),
                data: { "businessId": $('#txtBusinessId').val() },
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }

                    if (data.msg != "") {
                        swal({
                            title: data.msg,
                            icon: "error"
                        });
                        return;
                    }
                    $('#table').removeAttr('hidden');

                    $('#tbody').empty();
                    $('#businessRegistryNewTmpl').tmpl(data.ReturnObject).appendTo('#tbody');
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });

        });

        $('#btntDownloadFile').click(function () {
            let businessId = $('#txtBusinessId').val();
            if (businessId == "") {
                swal({
                    title: "請輸入統一編號",
                    icon: "error"
                });
                return;
            }

            $('.loader').addClass("is-active");

            $.ajax({
                type: "POST",
                url: Router.action('BusinessRegistryNew', 'GetExcel'),
                data: { "businessId": $('#txtBusinessId').val() },
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                + '&filename=' + data.fileName;
                            //window.location = path;
                            window.open(path);

                        }
                    }
                    file.outerHTML = file.outerHTML; //重置了file的outerHTML
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        })

    </script>

}
