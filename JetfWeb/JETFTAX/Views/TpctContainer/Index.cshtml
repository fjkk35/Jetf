
@{
    ViewBag.Title = "UploadFile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">TPCT貨櫃動態查詢</span>
<hr />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="UploadFileForm" action="@Url.Action("Index", "TpctContainer")" method="post" enctype="multipart/form-data" class="containertype">
    <label>查詢貨櫃編號</label>
    <div>
        <textarea id="txtContainerNo" style="height:200px"></textarea>
    </div>
    <div id="btntDownloadFile" type="button" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-download"></i> 下載</div>

    <div class="loader loader-bar" data-rounded data-text="查詢中"></div>
</form>

@{
    <script>

        $('#collapseWorkLoad').addClass("show");
        $('#TpctContainer').addClass("active");

        $('#btntDownloadFile').click(function () {
            $('.loader').addClass("is-active");

            $.ajax({
                type: "POST",
                url: Router.action('TpctContainer', 'Download'),
                data: { "data": $('#txtContainerNo').val() },
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                + '&filename=' + data.fileName;
                            //window.location = path;
                            window.open(path);
                        }
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        });
    </script>

}

