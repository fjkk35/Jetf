@{
    ViewBag.Title = "UploadExportFlight";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/dist/sweetalert/sweetalert2.all.min.js"></script>
<link href="~/Content/dist/sweetalert/sweetalert2.min.css" rel="stylesheet" />

<span class="headtype">上傳空運出口航班及出入倉時間</span>
<hr />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="UploadFileForm" action="@Url.Action("UploadExportFlight", "ExportClearance")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin:0.5rem 0;">
        <input type="file" name="file" id="fileTax" />
    </div>
    <div class="col-lg-12" style="margin:0.5rem 0;">
        <a href='~/Download/DownloadExample?filePath=@AppDomain.CurrentDomain.BaseDirectory\Download\上傳空運出口航班及出入倉時間_範例.xlsx&fileName=上傳空運出口航班及出入倉時間_範例.xlsx' target='_blank'>下載空運出口航班及出入倉時間範例</a>
    </div>
    <div id="btntUploadFile" type="button" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-upload"></i> 上傳</div>

    <div class="loader loader-bar" data-rounded data-text="檔案上傳中"></div>
</form>

@{
    <script>

        $('#collapseCCLWork').addClass("show");
        $('#UploadExportFlight').addClass("active");

        $('#btntUploadFile').click(function () {
            $('.loader').addClass("is-active");

            var file = document.getElementById('fileTax');
            var postData = new FormData($('#UploadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('ExportClearance', 'UploadExportFlight'),
                data: postData,
                cache: false,
                dataType: 'json',
                processData: false,
                //async: false,
                contentType: false,
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.status == "success") {
                            Swal.fire({
                                title: data.msg,
                                icon: "success"
                            });
                        }
                        else {
                            //顯示錯誤資訊
                            Swal.fire({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        file.outerHTML = file.outerHTML; //重置了file的outerHTML
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        })
    </script>
}


