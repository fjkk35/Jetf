@{
    ViewBag.Title = "上傳檔案(A03、B6F、班機派件送達)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="FlightArrivalUploadController">
    <span class="headtype">上傳檔案(A03、B6F、班機派件送達)</span>
    <hr />

    <form id="UploadFileForm"
          method="post"
          enctype="multipart/form-data"
          class="containertype"
          ng-submit="upload()">
        <div class="col-lg-12" style="margin:0.5rem 0;">
            <input type="file" name="file" id="fileTax" accept=".xlsx" ng-disabled="uploading" />
        </div>
        <div class="col-lg-12" style="margin:0.5rem 0;">
            <a href='~/Download/DownloadExample?filePath=@AppDomain.CurrentDomain.BaseDirectory\Download\上傳檔案(A03、B6F、班機派件送達)_範例.xlsx&fileName=上傳檔案(A03、B6F、班機派件送達)_範例.xlsx' target='_blank'>下載範例</a>
        </div>
        <div class="col-lg-12" style="margin:0.5rem 0;">
            <button id="btntUploadFile" type="submit"
                    class="btn btn-primary confirmbtn col-lg-3"
                    style="font-size:1.2rem;"
                    ng-disabled="uploading">
                <i class="fas fa-upload"></i> {{ uploading ? '上傳中...' : '上傳' }}
            </button>
        </div>
        <div class="loader loader-bar" ng-class="{'is-active': uploading}" data-rounded data-text="檔案上傳中"></div>
    </form>
</div>
