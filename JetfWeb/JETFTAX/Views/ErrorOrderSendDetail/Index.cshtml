@model JETFTAX.Models.ErrorOrderSendDetail.ErrorOrderSendDetailViewModel

@{
    ViewBag.Title = "CCStatusReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/x-jquery-tmpl" id="errorOrderSendDetailTmpl">
    <tr>
        <td>${Phone}</td>
        <td>${Customer}</td>
        <td>${Platform}</td>
        <td>${TrackingNo}</td>
        <td>${SendType}</td>
        <td>${IsSend}</td>
        <td>${SendResult}</td>
        <td>${SendResultMessage}</td>
        <td>${SendDateTime}</td>
        <td>${Message}</td>
    </tr>
</script>

<span class="headtype">錯單發送明細</span>
<hr />
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.StartDate)
        @Html.TextBoxFor(m => m.StartDate, new { @class = "form-control" })~
        @Html.TextBoxFor(m => m.EndDate, new { @class = "form-control" })
    </div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.TrackingNo)
        @Html.TextBoxFor(m => m.TrackingNo, new { @class = "form-control" })
    </div>
    <div id="btntSearch" class="btn btn-success col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-search"></i> 查詢</div>

    <hr />
    <div class="col-12">
        <table id="table" class="dataTable no-footer dtr-column" border="1">
            <thead>
                <tr>
                    <th>手機</th>
                    <th>客戶</th>
                    <th>平台</th>
                    <th>分提單號</th>
                    <th>發送類別</th>
                    <th>發送狀態</th>
                    <th>發送結果</th>
                    <th>發送結果訊息</th>
                    <th>發送時間</th>
                    <th>訊息</th>
                </tr>
            </thead>
            <tbody>

            </tbody>
        </table>
    </div>

    <div class="loader loader-bar" data-rounded data-text="執行中"></div>
</div>

<script>
    $('#collapseSend').addClass("show");
    $('#ErrorOrderSendDetail').addClass("active");


    //日期
    $('#StartDate').click(function () {
        WdatePicker({ dateFmt: 'yyyy-MM-dd' });
    });

    $('#EndDate').click(function () {
        WdatePicker({ dateFmt: 'yyyy-MM-dd' });
    });

    $('#btntSearch').click(function () {

        $('.loader').addClass("is-active");
        var requestData = {
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val(),
            TrackingNo: $('#TrackingNo').val()
        };

        $.ajax({
            type: "POST",
            url: Router.action('ErrorOrderSendDetail', 'Query'),
            data: requestData,
            cache: false,
            dataType: 'json',
            success: function (data) {
                if (data.Redirect) {
                    window.location = Router.action('Account', 'Login');
                } else {
                    if (data.status == "success") {
                        // 清空表格內容
                        $('#table tbody').empty();
                        $('#errorOrderSendDetailTmpl').tmpl(data.ReturnObject).appendTo('#table tbody');
                    } else {
                        //顯示錯誤資訊
                        swal({
                            title: data.msg,
                            icon: "error"
                        });
                    }
                }
            }
        }).then(function () {
            $('.loader').removeClass("is-active");
        });
    })

</script>
