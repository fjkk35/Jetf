@{
    ViewBag.Title = "SeaWorkErrorOrderReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">海快作業錯單統計報表</span>
<hr />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="UploadFileForm" action="@Url.Action("", "SeaWorkErrorOrderReport")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin:0.5rem 0;">
        <label>主號</label>
        <div>
            <textarea id="txtMainNumber" style="height:300px"></textarea>
        </div>
    </div>
    <div id="btntDownload" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem; "><i class="fas fa-download"></i> 下載</div>
    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</form>

@{
    <script>

        $('#collapseSeaWork').addClass("show");
        $('#SeaWorkErrorOrderReport').addClass("active");

        //日期
        $('#StartDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#EndDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#btntDownload').click(function () {
            let mainNumber = $('#txtMainNumber').val();
            if (mainNumber == "") {
                swal({
                    title: "請輸入主號",
                    icon: "error"
                });
                return;
            }

            $('.loader').addClass("is-active");

            $.ajax({
                type: "POST",
                url: Router.action('SeaWorkErrorOrderReport', 'Download'),
                data: { "mainNumber": mainNumber },
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') +
                                '?fileGuid=' + encodeURIComponent(data.fileGuid) +
                                '&filename=' + encodeURIComponent(data.fileName);

                            // 建立隱藏 <a> 並觸發下載
                            var link = document.createElement('a');
                            link.href = path;
                            link.download = data.fileName;
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);
                        }
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        })
    </script>
}


