@{
    ViewBag.Title = "Ftz查詢";
}

<div ng-controller="FtzController" class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2>Ftz查詢</h2>
            <hr />

            <!-- 登入區塊 -->
            <div class="panel panel-primary" ng-show="!isLoggedIn">
                <div class="panel-heading">
                    <h3 class="panel-title">登入資訊</h3>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-2 control-label">帳號</label>
                            <div class="col-sm-4">
                                <input type="text" class="form-control" ng-model="loginData.userId" placeholder="請輸入帳號" ng-disabled="isLoggedIn" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">密碼</label>
                            <div class="col-sm-4">
                                <input type="password" class="form-control" ng-model="loginData.userPd" placeholder="請輸入密碼" ng-disabled="isLoggedIn" />
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-2 col-sm-10">
                                <button type="button" class="btn btn-primary" ng-click="login()" ng-disabled="isLoading || isLoggedIn">
                                    <i class="fa fa-sign-in"></i> 登入
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- 查詢區塊 -->
            <div class="panel panel-info" ng-show="isLoggedIn">
                <div class="panel-heading">
                    <h3 class="panel-title">查詢類型</h3>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <div class="col-sm-4">
                                <select class="form-control" ng-model="selectedQueryType">
                                    <option ng-repeat="type in queryTypes" value="{{type.value}}">{{type.label}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-8">
                            <textarea class="form-control"
                                      rows="10"
                                      ng-model="queryData.hwbqList"
                                      placeholder="請輸入資料，每行一筆"></textarea>
                            </div>
                        </div>
                        <div class="form-group" ng-show="selectedQueryType === 'mwb'">
                            <div class="col-sm-8">
                                <input id="mainUploadFile"
                                       type="file"
                                       class="form-control"
                                       accept=".xlsx,.xls"
                                       ng-disabled="isLoading"
                                       onchange="angular.element(this).scope().onMainUploadFileChanged(this)" />
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-2 col-sm-10">
                                <button type="button" class="btn btn-success" ng-click="queryUnified()" ng-disabled="isLoading" ng-show="selectedQueryType !== 'mwb'">
                                    <i class="fa fa-search"></i> 查詢
                                </button>
                                <button type="button" class="btn btn-warning" ng-click="clearResults()" ng-disabled="isLoading">
                                    <i class="fa fa-eraser"></i> 清除
                                </button>
                                <button type="button" class="btn btn-info" ng-click="exportExcel()" ng-disabled="isLoading">
                                    <i class="fa fa-file-excel-o"></i> 匯出 Excel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading -->
            <div ng-show="isLoading" class="text-center">
                <i class="fa fa-spinner fa-spin fa-3x"></i>
                <p>處理中...</p>
            </div>

            <!-- 併袋號查詢結果 -->
            <div class="panel panel-success" ng-show="bagQueryResults.length > 0 && selectedQueryType === 'bag'">
                <div class="panel-heading">
                    <h3 class="panel-title">併袋號查詢結果（共 {{bagQueryResults.length}} 筆）</h3>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <colgroup>
                                <col style="width: 8%;"><!-- 袋號 -->
                                <col style="width: 10%;"><!-- 報單號碼 -->
                                <col style="width: 8%;"><!-- 主號 -->
                                <col style="width: 8%;"><!-- 分號 -->
                                <col style="width: 6%;"><!-- 航班 -->
                                <col style="width: 5%;"><!-- 重量 -->
                                <col style="width: 5%;"><!-- 申報 -->
                                <col style="width: 8%;"><!-- 進倉 -->
                                <col style="width: 8%;"><!-- 出倉 -->
                                <col style="width: 8%;"><!-- 通關方式 -->
                                <col style="width: 8%;"><!-- 驗貨窗口 -->
                                <col style="width: 18%;"><!-- 備註 -->
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>袋號</th>
                                    <th>報單號碼</th>
                                    <th>主號</th>
                                    <th>分號</th>
                                    <th>航班</th>
                                    <th>重量</th>
                                    <th>申報</th>
                                    <th>進倉</th>
                                    <th>出倉</th>
                                    <th>通關方式</th>
                                    <th>驗貨窗口</th>
                                    <th>備註</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in bagQueryResults">
                                    <td>{{item.bagNo}}</td>
                                    <td>{{item.declNo}}</td>
                                    <td>{{item.mwb}}</td>
                                    <td>{{item.hwb}}</td>
                                    <td>{{item.flightNo}}</td>
                                    <td>{{item.gciWeight}}</td>
                                    <td>{{item.piece}}</td>
                                    <td>{{item.gciPiece}}</td>
                                    <td>{{item.gcoPiece}}</td>
                                    <td>{{item.clearanceType}}</td>
                                    <td>{{item.examinationNote}}</td>
                                    <td>{{item.remarks}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 分提單號查詢結果 -->
            <div class="panel panel-success" ng-show="results.length > 0 && selectedQueryType === 'hwb'">
                <div class="panel-heading">
                    <h3 class="panel-title">查詢結果（共 {{results.length}} 筆）</h3>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <colgroup>
                                <col style="width: 8%;"><!-- 主號 -->
                                <col style="width: 8%;"><!-- 分提單號 -->
                                <col style="width: 8%;"><!-- 報單號碼 -->
                                <col style="width: 5%;"><!-- 類別 -->
                                <col style="width: 6%;"><!-- 通關方式 -->
                                <col style="width: 6%;"><!-- 箱號 -->
                                <col style="width: 5%;"><!-- 進出口別 -->
                                <col style="width: 8%;"><!-- 放行時間 -->
                                <col style="width: 6%;"><!-- 公司編號 -->
                                <col style="width: 5%;"><!-- 申報件數 -->
                                <col style="width: 5%;"><!-- 申報重量 -->
                                <col style="width: 8%;"><!-- 進倉時間 -->
                                <col style="width: 8%;"><!-- 公司名稱 -->
                                <col style="width: 5%;"><!-- 進倉件數 -->
                                <col style="width: 5%;"><!-- 進倉重量 -->
                                <col style="width: 8%;"><!-- 出倉時間 -->
                                <col style="width: 5%;"><!-- 出倉件數 -->
                                <col style="width: 10%;"><!-- 錯誤訊息 -->
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>主號</th>
                                    <th>分提單號</th>
                                    <th>報單號碼</th>
                                    <th>類別</th>
                                    <th>通關方式</th>
                                    <th>箱號</th>
                                    <th>進出口別</th>
                                    <th>放行時間</th>
                                    <th>公司編號</th>
                                    <th>申報件數</th>
                                    <th>申報重量</th>
                                    <th>進倉時間</th>
                                    <th>公司名稱</th>
                                    <th>進倉件數</th>
                                    <th>進倉重量</th>
                                    <th>出倉時間</th>
                                    <th>出倉件數</th>
                                    <th>錯誤訊息</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in results">
                                    <td>{{item.Mwb}}</td>
                                    <td>{{item.Hwbq}}</td>
                                    <td>{{item.DeclNo}}</td>
                                    <td>{{item.DeclType}}</td>
                                    <td>{{item.ClearanceType}}</td>
                                    <td>{{item.BoxNo}}</td>
                                    <td>{{item.IE}}</td>
                                    <td>{{item.ReleaseTime}}</td>
                                    <td>{{item.BoxNoExpressId}}</td>
                                    <td>{{item.Piece}}</td>
                                    <td>{{item.Weight}}</td>
                                    <td>{{item.GciDate1}}</td>
                                    <td>{{item.BoxNoExpressCName}}</td>
                                    <td>{{item.GciPiece}}</td>
                                    <td>{{item.GciWeight}}</td>
                                    <td>{{item.GcoDate1}}</td>
                                    <td>{{item.GcoPiece}}</td>
                                    <td>{{item.Remark}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-responsive {
        max-height: 600px;
        overflow: auto; /* 改為 auto，同時支援水平和垂直捲軸 */
    }

    .table-responsive table {
        table-layout: fixed; /* 強制固定表格寬度 */
        min-width: 100%; /* 確保表格至少佔滿容器寬度 */
    }

    .table-responsive td,
    .table-responsive th {
        word-wrap: break-word; /* 允許長單詞換行 */
        word-break: break-all; /* 強制換行，即使在單詞中間 */
        white-space: normal; /* 允許換行 */
        overflow: hidden; /* 隱藏溢出內容 */
    }

    /* 如果想要使用省略符號而不是換行，可以取消下面的註解 */
    /*
    .table-responsive td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    */

    .panel {
        margin-bottom: 20px;
    }

    .help-block {
        font-size: 12px;
        color: #737373;
    }

    .alert-info p {
        margin: 5px 0;
    }

    .text-danger {
        font-weight: bold;
    }
</style>

