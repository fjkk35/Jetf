@{
    ViewBag.Title = "空快錯單統計及明細下載";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">空快錯單統計及明細下載</span>
<hr />

<div ng-controller="EtlErrorWorkController" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem; display:flex; align-items:center; gap:10px;">
        <label style="margin:0;">日期</label>
        <input type="text"
               id="sDate"
               class="datepicker-input form-control"
               style="width:180px;"
               ng-model="searchData.sDate"
               uib-datepicker-popup="yyyy-MM-dd"
               datepicker-options="dateOptions"
               is-open="sDatePopup.opened"
               ng-click="openSDatePopup()"
               close-text="關閉"
               current-text="今天"
               show-button-bar="false"
               readonly
               placeholder="請選擇開始日期" />
        <span>~</span>
        <input type="text"
               id="eDate"
               class="datepicker-input form-control"
               style="width:180px;"
               ng-model="searchData.eDate"
               uib-datepicker-popup="yyyy-MM-dd"
               datepicker-options="dateOptions"
               is-open="eDatePopup.opened"
               ng-click="openEDatePopup()"
               close-text="關閉"
               current-text="今天"
               show-button-bar="false"
               readonly
               placeholder="請選擇結束日期" />
    </div>
    
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        <label>群組</label>
        <select ng-model="searchData.selectedGroup" 
                class="form-control" 
                ng-disabled="loadingGroups"
                ng-change="onGroupChange()">
            <option value="">請選擇群組</option>
            <option ng-repeat="group in groupList" value="{{group.Id}}">{{group.GroupName}}</option>
        </select>
    </div>

    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        <label>
            客戶
            <span style="margin-left: 10px;">
                <a href="javascript:void(0)" ng-click="selectAllCustomers()" style="font-size: 0.9rem;">全選</a> | 
                <a href="javascript:void(0)" ng-click="deselectAllCustomers()" style="font-size: 0.9rem;">取消</a>
            </span>
        </label>
        <div ng-if="!loadingCustomers" class="row">
                <label ng-repeat="customer in customerList" class="col-2">
                    <input type="checkbox"
                           ng-model="customer.Selected"
                           style="cursor: pointer;height:auto" />
                    <span>{{customer.Text}}</span>
                </label>
        </div>
        <div ng-if="loadingCustomers" style="padding: 10px; text-align: center;">
            載入中...
        </div>
    </div>

    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        <button class="btn btn-primary confirmbtn col-lg-3" 
                style="font-size: 1.2rem;" 
                ng-click="downloadExcel()" 
                ng-disabled="downloading || loadingCustomers || loadingGroups">
            <i class="fas fa-download" ng-hide="downloading"></i>
            <i class="fas fa-spinner fa-spin" ng-show="downloading"></i>
            {{downloading ? '下載中...' : '下載'}}
        </button>
    </div>

    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</div>