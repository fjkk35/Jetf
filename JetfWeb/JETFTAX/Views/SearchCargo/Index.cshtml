@{
    ViewBag.Title = "貨況查詢";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Css("~/Content/Views/SearchCargo/Index.css")

<div ng-app="mainApp" ng-controller="SearchCargoController">
    <span class="headtype">貨況查詢V2</span>
    <hr />

    <div class="containertype">
        <!-- 查詢區域 -->
        <div class="search-section">
            <div class="search-row">
                <div class="form-group">
                    <select class="form-control"
                            ng-model="searchForm.searchType"
                            ng-options="option.value as option.text for option in searchTypeOptions">
                    </select>
                </div>
                <div class="form-group search-input-group">
                    <input type="text"
                           class="form-control"
                           ng-model="searchForm.searchValue"
                           ng-keypress="handleKeyPress($event)"
                           placeholder="請輸入查詢內容" />
                </div>
                <div class="form-group button-group">
                    <button class="btn btn-success" ng-click="search()" ng-disabled="loading">
                        <i class="fa" ng-class="{'fa-spinner fa-spin': loading, 'fa-search': !loading}"></i>
                        {{loading ? '查詢中...' : '查詢'}}
                    </button>
                    <button class="btn btn-secondary" ng-click="clearSearch()" ng-disabled="loading">
                        <i class="fas fa-eraser"></i> 清除
                    </button>
                </div>
            </div>
            <div class="shortcut-hint">{{shortcutHint}}</div>
        </div>

        <!-- 載入中 -->
        <div ng-if="loading" class="loading-container">
            <div class="text-center">
                <i class="fa fa-spinner fa-spin fa-3x"></i>
                <p>查詢中...</p>
            </div>
        </div>

        <!-- 資料表格 -->
        <div ng-if="!loading && data.length > 0" class="table-container">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th style="width: 5%;">明細</th>
                        <th style="width: 8%;">稅金作業日</th>
                        <th style="width: 8%;">倉儲類型</th>
                        <th style="width: 8%;">出倉日期</th>
                        <th style="width: 15%;">客戶名稱</th>
                        <th style="width: 8%;">主提單號</th>
                        <th style="width: 8%;">清關袋號</th>
                        <th style="width: 8%;">件數</th>
                        <th style="width: 10%;">物流貨號</th>
                        <th style="width: 20%;">品名</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in data">
                        <td>
                            <button class="btn btn-info btn-sm" ng-click="openDetail(item.Id, item.Source)">
                                明細
                            </button>
                        </td>
                        <td>{{item.F_DataDate}}</td>
                        <td>{{item.I_DATA_TYPE}}</td>
                        <td>{{item.Format_OUT_DATETIME}}</td>
                        <td>
                            <span>{{item.CUSTOMER}}</span>
                            <a ng-if="item.CUSTOMER === '新遞'"
                               ng-href="{{getConsignmentQueryUrl(searchForm.searchValue)}}"
                               target="_blank"
                               rel="noopener"
                               class="btn btn-primary btn-sm ml-2">
                                託運資料查詢
                            </a>
                        </td>
                        <td>{{item.MAINNUMBER}}</td>
                        <td>{{item.BL_NO}}</td>
                        <td>{{item.PIECE}}</td>
                        <td>{{item.DELIVERYNO}}</td>
                        <td>{{item.ITEM_NAME}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade search-cargo-detail-modal" id="cargoDetailModal" tabindex="-1" role="dialog" aria-label="貨況明細" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="search-cargo-detail-toolbar">
                    <button type="button" class="search-cargo-detail-close" data-dismiss="modal" aria-label="關閉">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <iframe ng-if="detailUrl" ng-src="{{detailUrl}}" id="cargoDetailFrame" title="貨況明細"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

