@{
    ViewBag.Title = "Tact查詢";
}

<div ng-controller="TactController" class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2>Tact查詢</h2>
            <hr />

            <!-- 登入區塊 -->
            <div class="panel panel-primary" ng-show="!isLoggedIn">
                <div class="panel-heading">
                    <h3 class="panel-title">登入資訊</h3>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-2 control-label">帳號</label>
                            <div class="col-sm-4">
                                <input type="text" class="form-control" ng-model="loginData.acctId" placeholder="請輸入帳號" ng-disabled="isLoggedIn" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">密碼</label>
                            <div class="col-sm-4">
                                <input type="password" class="form-control" ng-model="loginData.acctPw" placeholder="請輸入密碼" ng-disabled="isLoggedIn" />
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-2 col-sm-10">
                                <button type="button" class="btn btn-primary" ng-click="login()" ng-disabled="isLoading || isLoggedIn">
                                    <i class="fa fa-sign-in"></i> 登入
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 查詢區塊 -->
            <div class="panel panel-info" ng-show="isLoggedIn">
                <div class="panel-heading">
                    <h3 class="panel-title">查詢類型</h3>
                </div>
                <div class="panel-body">
                    <div class="form-horizontal">
                        <div class="form-group">
                            <div class="col-sm-4">
                                <select class="form-control" ng-model="selectedQueryType">
                                    <option ng-repeat="type in queryTypes" value="{{type.value}}">{{type.label}}</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-8">
                                <textarea class="form-control"
                                          rows="10"
                                          ng-model="queryData.inputList"
                                          placeholder="請輸入資料，每行一筆"></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-offset-2 col-sm-10">
                                <button type="button" class="btn btn-success" ng-click="queryUnified()" ng-disabled="isLoading">
                                    <i class="fa fa-search"></i> 查詢
                                </button>
                                <button type="button" class="btn btn-warning" ng-click="clearResults()" ng-disabled="isLoading">
                                    <i class="fa fa-eraser"></i> 清除
                                </button>
                                <button type="button" class="btn btn-info" ng-click="exportExcel()" ng-disabled="isLoading">
                                    <i class="fa fa-file-excel-o"></i> 匯出 Excel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading -->
            <div ng-show="isLoading" class="text-center">
                <i class="fa fa-spinner fa-spin fa-3x"></i>
                <p>處理中...</p>
            </div>

            <!-- 分號查詢結果 -->
            <div class="panel panel-success" ng-show="results.length > 0 && selectedQueryType === 'hwb'">
                <div class="panel-heading">
                    <h3 class="panel-title">查詢結果（共 {{results.length}} 筆）</h3>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>主提單號</th>
                                    <th>分提單號</th>
                                    <th>報關類別</th>
                                    <th>併袋號</th>
                                    <th>報單號碼</th>
                                    <th>通關方式</th>
                                    <th>申報件數</th>
                                    <th>進倉件數</th>
                                    <th>出倉件數</th>
                                    <th>申報重量</th>
                                    <th>進倉重量</th>
                                    <th>進倉時間</th>
                                    <th>出倉時間</th>
                                    <th>航機班次</th>
                                    <th>更改後報單</th>
                                    <th>稅費金額</th>
                                    <th>備註</th>
                                    <th>備註2</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in results">
                                    <td>{{item.MainNumber}}</td>
                                    <td>{{item.TrackingNo}}</td>
                                    <td>{{item.DeclType}}</td>
                                    <td>{{item.BagNumber}}</td>
                                    <td>{{item.DeclNo}}</td>
                                    <td>{{item.ClearanceType}}</td>
                                    <td>{{item.Piece}}</td>
                                    <td>{{item.GciPiece}}</td>
                                    <td>{{item.GcoPiece}}</td>
                                    <td>{{item.Weight}}</td>
                                    <td>{{item.GciWeight}}</td>
                                    <td>{{item.GciDate1}}</td>
                                    <td>{{item.GcoDate1}}</td>
                                    <td>{{item.FlightNo}}</td>
                                    <td>{{item.UpdateDecl}}</td>
                                    <td>{{item.Amount}}</td>
                                    <td>{{item.Remark}}</td>
                                    <td>{{item.Remark2}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 併袋號查詢結果 -->
            <div class="panel panel-success" ng-show="bagResults.length > 0 && selectedQueryType === 'bag'">
                <div class="panel-heading">
                    <h3 class="panel-title">併袋號查詢結果（共 {{bagResults.length}} 筆）</h3>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>併袋號</th>
                                    <th>主號</th>
                                    <th>分提單號</th>
                                    <th>報關類別</th>
                                    <th>報單號碼</th>
                                    <th>通關方式</th>
                                    <th>申報件數</th>
                                    <th>進倉件數</th>
                                    <th>出倉件數</th>
                                    <th>申報重量</th>
                                    <th>進倉重量</th>
                                    <th>進倉時間</th>
                                    <th>出倉時間</th>
                                    <th>航機班次</th>
                                    <th>更改後報單號</th>
                                    <th>計費金額</th>
                                    <th>備註</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in bagResults">
                                    <td>{{item.BagNumber}}</td>
                                    <td>{{item.Mwb}}</td>
                                    <td>{{item.TrackingNo}}</td>
                                    <td>{{item.DeclType}}</td>
                                    <td>{{item.DeclNo}}</td>
                                    <td>{{item.ClearanceType}}</td>
                                    <td>{{item.Piece}}</td>
                                    <td>{{item.GciPiece}}</td>
                                    <td>{{item.GcoPiece}}</td>
                                    <td>{{item.Weight}}</td>
                                    <td>{{item.GciWeight}}</td>
                                    <td>{{item.GciDate1}}</td>
                                    <td>{{item.GcoDate1}}</td>
                                    <td>{{item.FlightNo}}</td>
                                    <td>{{item.UpdateDecl}}</td>
                                    <td>{{item.Amount}}</td>
                                    <td>{{item.Remark}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 主號查詢結果 -->
            <div class="panel panel-success" ng-show="mainResults.length > 0 && selectedQueryType === 'mwb'">
                <div class="panel-heading">
                    <h3 class="panel-title">主號查詢結果（共 {{mainResults.length}} 筆）</h3>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <colgroup>
                                <col style="width: 8%;"><!-- 主號 -->
                                <col style="width: 8%;"><!-- 客戶名稱 -->
                                <col style="width: 6%;"><!-- 航班 -->
                                <col style="width: 4%;"><!-- 申報 -->
                                <col style="width: 4%;"><!-- 進倉 -->
                                <col style="width: 5%;"><!-- 未進倉件 -->
                                <col style="width: 4%;"><!-- B6F -->
                                <col style="width: 6%;"><!-- B6F分號 -->
                                <col style="width: 10%;"><!-- 未進倉件不含B6F分號 -->
                                <col style="width: 4%;"><!-- 併袋 -->
                                <col style="width: 5%;"><!-- 進倉袋 -->
                                <col style="width: 5%;"><!-- 未進倉袋 -->
                                <col style="width: 5%;"><!-- 未進倉小計 -->
                                <col style="width: 8%;"><!-- 未進倉申報袋號 -->
                                <col style="width: 5%;"><!-- 錯誤訊息 -->
                                <col ng-repeat="transName in getDistinctTransNames()" style="width: 5%;"><!-- 動態欄位 -->
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>主號</th>
                                    <th>客戶名稱</th>
                                    <th>航班</th>
                                    <th>申報</th>
                                    <th>進倉</th>
                                    <th>未進倉件</th>
                                    <th>B6F</th>
                                    <th>B6F分號</th>
                                    <th>未進倉件不含B6F分號</th>
                                    <th>併袋</th>
                                    <th>進倉袋</th>
                                    <th>未進倉袋</th>
                                    <th>未進倉小計</th>
                                    <th>未進倉申報袋號</th>
                                    <th>錯誤訊息</th>
                                    <th ng-repeat="transName in getDistinctTransNames()">{{transName}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in mainResults">
                                    <td>{{item.Mwb}}</td>
                                    <td>{{item.Customer}}</td>
                                    <td>{{item.FlightNumber}}</td>
                                    <td>{{item.Piece}}</td>
                                    <td>{{item.GciPiece}}</td>
                                    <td><span class="text-danger">{{item.NotGciPiece}}</span></td>
                                    <td>{{item.B6FCount}}</td>
                                    <td>{{item.B6FTrackingNo}}</td>
                                    <td>{{item.NotGciPieceNotB6F}}</td>
                                    <td>{{item.BagNumber}}</td>
                                    <td>{{item.GciBagNumber}}</td>
                                    <td><span class="text-danger">{{item.NotGciBagNumber}}</span></td>
                                    <td><span class="text-danger"><strong>{{item.NotGciPieceCount}}</strong></span></td>
                                    <td>{{item.NotGciPieceBagNumber}}</td>
                                    <td>{{item.ErrorMessage}}</td>
                                    <td ng-repeat="transName in getDistinctTransNames()">{{getTransNameCount(item, transName)}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- 未進倉明細 -->
                    <div ng-repeat="mainItem in mainResults" ng-show="mainItem.NotGciDetails && mainItem.NotGciDetails.length > 0">
                        <h4>{{mainItem.Mwb}} - 未進倉明細（{{mainItem.NotGciDetails.length}} 筆）</h4>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover table-condensed">
                                <thead>
                                    <tr>
                                        <th>項次</th>
                                        <th>分提單號</th>
                                        <th>報關類別</th>
                                        <th>併袋號</th>
                                        <th>報單號碼</th>
                                        <th>通關方式</th>
                                        <th>申報件數</th>
                                        <th>進倉件數</th>
                                        <th>出倉件數</th>
                                        <th>申報重量</th>
                                        <th>進倉重量</th>
                                        <th>進倉時間</th>
                                        <th>出倉時間</th>
                                        <th>航機班次</th>
                                        <th>更改後報單號</th>
                                        <th>稅費金額</th>
                                        <th>B6F</th>
                                        <th>派件公司</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="detail in mainItem.NotGciDetails">
                                        <td>{{$index + 1}}</td>
                                        <td>{{detail.TrackingNo}}</td>
                                        <td>{{detail.DeclType}}</td>
                                        <td>{{detail.BagNumber}}</td>
                                        <td>{{detail.DeclNo}}</td>
                                        <td>{{detail.ClearanceType}}</td>
                                        <td>{{detail.Piece}}</td>
                                        <td>{{detail.GciPiece}}</td>
                                        <td>{{detail.GcoPiece}}</td>
                                        <td>{{detail.Weight}}</td>
                                        <td>{{detail.GciWeight}}</td>
                                        <td>{{detail.GciDate1}}</td>
                                        <td>{{detail.GcoDate1}}</td>
                                        <td>{{detail.FlightNo}}</td>
                                        <td>{{detail.UpdateDecl}}</td>
                                        <td>{{detail.Amount}}</td>
                                        <td>{{detail.B6F ? '是' : '否'}}</td>
                                        <td>{{detail.TransName}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

