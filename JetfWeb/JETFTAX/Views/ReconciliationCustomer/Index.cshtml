@{
    ViewBag.Title = "客戶銷帳";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid reconciliation-customer-page"
     ng-controller="ReconciliationCustomerController"
     ng-init="init()">
    <span class="headtype">客戶銷帳</span>
    <hr />

    <div class="card bg-light rounded p-4 mb-4" style="border:none">
        <div class="row align-items-start">
            <div class="form-group row col-xl-4 col-lg-6 mb-3">
                <label class="col-sm-2 col-form-label text-right">日期</label>
                <div class="col-sm-10 d-flex align-items-center">
                    <input type="text"
                           class="datepicker-input form-control"
                           ng-model="searchForm.outDateStart"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="startDatePopup.opened"
                           ng-click="openStartDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           required
                           placeholder="開始日期"
                           autocomplete="off" />
                    <span class="mx-2">~</span>
                    <input type="text"
                           class="datepicker-input form-control"
                           ng-model="searchForm.outDateEnd"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="endDatePopup.opened"
                           ng-click="openEndDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           required
                           placeholder="結束日期"
                           autocomplete="off" />
                </div>
            </div>

            <div class="form-group row col-xl-3 col-lg-6 mb-3">
                <label class="col-sm-3 col-form-label text-right">客戶</label>
                <div class="col-sm-9">
                    <reconciliation-customer-selector
                        options-url="@Url.Action("GetCustomerSelectionOptions", "ReconciliationCustomer")"
                        selected-customer-map="selectedCustomerMap"
                        disabled="loading || confirming">
                    </reconciliation-customer-selector>
                </div>
            </div>

            <div class="form-group row col-xl-5 col-lg-12 mb-3">
                <label class="col-sm-2 col-form-label text-right">物流貨號</label>
                <div class="col-sm-10">
                    <textarea class="form-control"
                              rows="3"
                              ng-model="searchForm.dlvInvText"
                              placeholder="每行輸入一筆物流貨號"></textarea>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 text-right">
                <button type="button" class="btn btn-primary" ng-click="search()" ng-disabled="loading || confirming">
                    <i class="fa fa-search"></i> 查詢
                </button>
                <button type="button" class="btn btn-secondary ml-2" ng-click="clearSearch()" ng-disabled="loading || confirming">
                    <i class="fa fa-eraser"></i> 清除
                </button>
            </div>
        </div>
    </div>

    <div ng-show="loading" class="text-center py-4">
        <i class="fa fa-spinner fa-spin fa-3x"></i>
        <p>載入中...</p>
    </div>

    <div ng-show="isSearched && !loading" class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th class="text-right">應收金額</th>
                    <th class="text-center" style="width: 180px;">操作</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-if="result.ReceivableAmount <= 0">
                    <td colspan="2" class="text-center">查無資料</td>
                </tr>
                <tr ng-if="result.ReceivableAmount > 0">
                    <td class="text-right">{{result.ReceivableAmount | number:0}}</td>
                    <td class="text-center">
                        <button type="button"
                                class="btn btn-primary"
                                ng-click="openConfirmModal()"
                                ng-disabled="confirming || result.ReceivableAmount <= 0">
                            <i class="fa fa-check"></i> 確認銷帳
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="reconciliationCustomerConfirmModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">確認客戶銷帳</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label text-right">應收金額</label>
                        <div class="col-sm-8 col-form-label text-right font-weight-bold">
                            {{result.ReceivableAmount | number:0}}
                        </div>
                    </div>
                    <div class="form-group row mb-0">
                        <label class="col-sm-4 col-form-label text-right">銷帳金額</label>
                        <div class="col-sm-8">
                            <input type="number"
                                   class="form-control text-right"
                                   ng-model="confirmAmount"
                                   min="1"
                                   step="1"
                                   placeholder="請輸入銷帳金額" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" ng-disabled="confirming">取消</button>
                    <button type="button" class="btn btn-primary" ng-click="confirm()" ng-disabled="confirming">
                        <i class="fa" ng-class="confirming ? 'fa-spinner fa-spin' : 'fa-check'"></i>
                        {{confirming ? '銷帳中...' : '確認銷帳'}}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media (max-width: 767.98px) {
        .reconciliation-customer-page .form-group label {
            text-align: left !important;
        }
    }
</style>
