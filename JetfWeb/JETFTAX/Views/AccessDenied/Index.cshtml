@{
    ViewBag.Title = "權限不足";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8 col-md-10">
            <div class="py-5 text-center" role="alert" aria-labelledby="accessDeniedTitle">
                <i class="fas fa-lock fa-3x text-danger mb-4" aria-hidden="true"></i>
                <h1 id="accessDeniedTitle" class="h3 font-weight-bold text-gray-800 mb-3">權限不足</h1>
                <h4 class="text-gray-700 mb-2">您的帳號沒有此功能的使用權限。</h4>
                <h4 class="text-gray-600 mb-4">如需使用此功能，請聯絡系統管理員。</h4>
            </div>
        </div>
    </div>
</div>
