@{
    ViewBag.Title = "撿貨明細";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="ShipmentInboundPickController">
    <span class="headtype">撿貨明細</span>
    <hr />

    <!-- 查詢條件區域 -->
    <div class="card bg-light rounded p-4 mb-4" style="border:none">
        <div class="row mb-3 align-items-center">
            <!-- 日期(起) -->
            <div class="form-group row col-lg-4 mb-0">
                <label for="processTimeStart" class="col-lg-4 col-form-label text-right">客服輸入日期(起)</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="processTimeStart"
                           class="datepicker-input form-control"
                           ng-model="searchForm.processTimeStart"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="startDatePopup.opened"
                           ng-click="openStartDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           placeholder="請選擇開始日期" />
                </div>
            </div>

            <!-- 日期(迄) -->
            <div class="form-group row col-lg-4 mb-0">
                <label for="processTimeEnd" class="col-lg-4 col-form-label text-right">客服輸入日期(迄)</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="processTimeEnd"
                           class="datepicker-input form-control"
                           ng-model="searchForm.processTimeEnd"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="endDatePopup.opened"
                           ng-click="openEndDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           placeholder="請選擇結束日期" />
                </div>
            </div>

            <!-- 客戶 -->
            <div class="form-group row col-lg-4 mb-0">
                <label for="custCodeOption" class="col-lg-4 col-form-label text-right">客戶</label>
                <div class="col-lg-8">
                    <customer-multi-select select-all="customerSelectAll"
                                           selected-cust-codes="selectedCustCodes"
                                           display-text="customerDisplayText"
                                           display-full-text="customerDisplayFullText">
                    </customer-multi-select>
                </div>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <div class="form-group row col-lg-4 mb-0">
                <label for="processType" class="col-lg-4 col-form-label text-right">處理方式</label>
                <div class="col-lg-8">
                    <select id="processType"
                            class="form-control"
                            ng-model="searchForm.processType">
                        <option value="">全部</option>
                        <option ng-repeat="type in processTypeList" value="{{type.Value}}">{{type.Text}}</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- 按鈕區 -->
        <div class="row">
            <div class="col-lg-12 text-right">
                <button type="button"
                        class="btn btn-primary"
                        ng-click="search()"
                        ng-disabled="loading">
                    <i class="fa fa-search"></i> 查詢
                </button>
                <button type="button"
                        class="btn btn-success ml-2"
                        ng-click="exportExcel()">
                    <i class="fa fa-file-excel-o"></i> 匯出Excel
                </button>
                <button type="button"
                        class="btn btn-secondary ml-2"
                        ng-click="clearSearch()"
                        ng-disabled="loading">
                    <i class="fa fa-eraser"></i> 清除
                </button>
            </div>
        </div>
    </div>
    <hr />

    <!-- 載入中提示 -->
    <div ng-show="loading" class="text-center">
        <i class="fa fa-spinner fa-spin fa-3x"></i>
        <p>載入中...</p>
    </div>

    <!-- 查詢結果區域 -->
    <div ng-show="isSearched && !loading">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <!-- 資料筆數資訊 -->
                    <div class="row mb-2">
                        <div class="col-lg-12 text-right">
                            <span>共 {{data.length}} 筆資料</span>
                        </div>
                    </div>

                    <!-- 資料表格 -->
                    <div class="table-responsive mt-3">
                        <table class="table table-bordered table-striped table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th>序號</th>
                                    <th>單號</th>
                                    <th>客戶</th>
                                    <th>流水號</th>
                                    <th>儲位</th>
                                    <th>處理方式</th>
                                    <th>派件公司</th>
                                    <th>重出派件公司</th>
                                    <th>備註</th>
                                    <th>客服處理時間</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-if="data.length === 0">
                                    <td colspan="10" class="text-center">查無資料</td>
                                </tr>
                                <tr ng-repeat="item in data">
                                    <td>{{$index + 1}}</td>
                                    <td>{{item.TrackingNo}}</td>
                                    <td>{{item.CustName}}</td>
                                    <td>{{item.SeqNo}}</td>
                                    <td>{{item.LocationCode}}</td>
                                    <td>{{item.ProcessTypeName}}</td>
                                    <td>{{item.TransName}}</td>
                                    <td>{{item.ProcessTransName}}</td>
                                    <td>{{item.Remark}}</td>
                                    <td>{{item.ProcessTime | customDateTime}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

