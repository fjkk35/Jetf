@{
    ViewBag.Title = "物流銷帳";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid reconciliation-logistics-page"
     ng-controller="ReconciliationLogisticsController"
     ng-init="init()">
    <span class="headtype">物流銷帳</span>
    <hr />

    <div class="card bg-light rounded p-4 mb-4" style="border:none">
        <div class="row align-items-center">
            <div class="col-xl-3 col-lg-6">
                <div class="form-group row mb-3">
                    <label for="repaymentDateStart"
                           class="col-sm-4 col-form-label text-right">回款日期(起)</label>
                    <div class="col-sm-8">
                        <input type="text"
                               id="repaymentDateStart"
                               class="datepicker-input form-control"
                               ng-model="searchForm.repaymentDateStart"
                               uib-datepicker-popup="yyyy-MM-dd"
                               datepicker-options="dateOptions"
                               is-open="searchStartDatePopup.opened"
                               ng-click="openSearchStartDatePopup()"
                               close-text="關閉"
                               current-text="今天"
                               show-button-bar="false"
                               readonly
                               required
                               placeholder="開始日期"
                               autocomplete="off" />
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-6">
                <div class="form-group row mb-3">
                    <label for="repaymentDateEnd"
                           class="col-sm-4 col-form-label text-right">回款日期(迄)</label>
                    <div class="col-sm-8">
                        <input type="text"
                               id="repaymentDateEnd"
                               class="datepicker-input form-control"
                               ng-model="searchForm.repaymentDateEnd"
                               uib-datepicker-popup="yyyy-MM-dd"
                               datepicker-options="dateOptions"
                               is-open="searchEndDatePopup.opened"
                               ng-click="openSearchEndDatePopup()"
                               close-text="關閉"
                               current-text="今天"
                               show-button-bar="false"
                               readonly
                               required
                               placeholder="結束日期"
                               autocomplete="off" />
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-6">
                <div class="form-group row mb-3">
                    <label for="companyOption"
                           class="col-sm-4 col-form-label text-right">物流公司</label>
                    <div class="col-sm-8">
                        <select id="companyOption"
                                class="form-control"
                                ng-model="searchForm.company"
                                ng-disabled="optionsLoading || loading">
                            <option value="">全部</option>
                            <option ng-repeat="item in companies track by item.Value"
                                    value="{{item.Value}}">{{item.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-6">
                <div class="form-group row mb-3">
                    <label for="statusOption"
                           class="col-sm-4 col-form-label text-right">狀態</label>
                    <div class="col-sm-8">
                        <select id="statusOption"
                                class="form-control"
                                ng-model="searchForm.status"
                                ng-disabled="optionsLoading || loading">
                            <option value="">全部</option>
                            <option ng-repeat="item in statuses track by item.Value"
                                    value="{{item.Value}}">{{item.Text}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row align-items-center">
            <div class="col-xl-3 col-lg-6">
                <div class="form-group row mb-3">
                    <label for="trackingNo"
                           class="col-sm-4 col-form-label text-right">分提單號</label>
                    <div class="col-sm-8">
                        <input type="text"
                               id="trackingNo"
                               class="form-control"
                               ng-model="searchForm.trackingNo"
                               ng-disabled="loading"
                               maxlength="50" />
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-6">
                <div class="form-group row mb-3">
                    <label for="dlvInv"
                           class="col-sm-4 col-form-label text-right">物流貨號</label>
                    <div class="col-sm-8">
                        <input type="text"
                               id="dlvInv"
                               class="form-control"
                               ng-model="searchForm.dlvInv"
                               ng-disabled="loading"
                               maxlength="50" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 text-right">
                <button type="button"
                        class="btn btn-primary"
                        ng-click="search()"
                        ng-disabled="loading || optionsLoading">
                    <i class="fa fa-search"></i> 查詢
                </button>
                <button type="button"
                        class="btn btn-secondary ml-2"
                        ng-click="clearSearch()"
                        ng-disabled="loading">
                    <i class="fa fa-eraser"></i> 清除
                </button>
                <button type="button"
                        class="btn btn-info ml-2"
                        ng-click="openUploadModal()"
                        ng-disabled="loading || uploading || optionsLoading">
                    <i class="fa fa-upload"></i> 批量上傳
                </button>
                <button type="button"
                        class="btn btn-warning ml-2"
                        ng-click="openComparisonModal()"
                        ng-disabled="loading || uploading || comparing || optionsLoading">
                    <i class="fa fa-file-excel-o"></i> 比對明細
                </button>
            </div>
        </div>
    </div>

    <div ng-show="loading" class="text-center py-4">
        <i class="fa fa-spinner fa-spin fa-3x"></i>
        <p>載入中...</p>
    </div>

    <div ng-show="isSearched && !loading">
        <div class="row mb-2 align-items-center">
            <div class="col-md-6">
                <div class="form-inline">
                    <label class="mr-2">每頁顯示</label>
                    <select class="form-control"
                            ng-model="pageSize"
                            ng-change="changePageSize()">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                    <label class="ml-2">筆</label>
                </div>
            </div>
            <div class="col-md-6 text-right">
                <span>{{recordsInfo}}</span>
            </div>
        </div>

        <div class="table-responsive reconciliation-logistics-table-wrapper">
            <table class="table table-bordered table-striped table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>回款日期</th>
                        <th>物流公司</th>
                        <th>客戶代號</th>
                        <th>分提單號</th>
                        <th>物流貨號</th>
                        <th class="text-right">回款金額</th>
                        <th class="text-right">差異</th>
                        <th>狀態</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-if="rows.length === 0">
                        <td colspan="8" class="text-center">查無資料</td>
                    </tr>
                    <tr ng-repeat="row in rows track by row.Id">
                        <td>{{row.RepaymentDate}}</td>
                        <td>{{row.Company}}</td>
                        <td>{{row.CustomerCode}}</td>
                        <td>{{row.TrackingNo}}</td>
                        <td>{{row.DlvInv}}</td>
                        <td class="text-right">{{row.ReceivedAmount | number:0}}</td>
                        <td class="text-right">{{row.DifferenceAmount | number:0}}</td>
                        <td>{{row.Status}}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <nav class="reconciliation-logistics-pagination"
             ng-if="totalPages > 1"
             aria-label="物流銷帳分頁">
            <ul class="pagination justify-content-center">
                <li class="page-item" ng-class="{disabled: currentPage === 1}">
                    <button type="button" class="page-link" ng-click="goToPage(1)">第一頁</button>
                </li>
                <li class="page-item" ng-class="{disabled: currentPage === 1}">
                    <button type="button" class="page-link" ng-click="previousPage()">上一頁</button>
                </li>
                <li class="page-item"
                    ng-repeat="page in getPageNumbers() track by page"
                    ng-class="{active: page === currentPage}">
                    <button type="button"
                            class="page-link"
                            ng-click="goToPage(page)">{{page}}</button>
                </li>
                <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                    <button type="button" class="page-link" ng-click="nextPage()">下一頁</button>
                </li>
                <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                    <button type="button"
                            class="page-link"
                            ng-click="goToPage(totalPages)">最後一頁</button>
                </li>
            </ul>
        </nav>
    </div>

    <div class="modal fade reconciliation-logistics-upload-modal reconciliation-logistics-comparison-modal"
         id="reconciliationLogisticsUploadModal"
         tabindex="-1"
         role="dialog"
         data-keyboard="false">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">批量上傳物流銷帳</h5>
                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            ng-disabled="uploading"
                            aria-label="關閉">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-group row">
                        <label class="col-lg-2 col-md-3 col-form-label text-right">回款日期</label>
                        <div class="col-lg-4 col-md-6">
                            <input type="text"
                                   class="datepicker-input form-control"
                                   ng-model="uploadForm.repaymentDate"
                                   uib-datepicker-popup="yyyy-MM-dd"
                                   datepicker-options="dateOptions"
                                   is-open="uploadDatePopup.opened"
                                   ng-click="openUploadDatePopup()"
                                   close-text="關閉"
                                   current-text="今天"
                                   show-button-bar="false"
                                   readonly
                                   required
                                   autocomplete="off"
                                   ng-disabled="uploading" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-lg-2 col-md-3 col-form-label text-right">物流公司</label>
                        <div class="col-lg-4 col-md-6">
                            <select class="form-control"
                                    ng-model="uploadForm.company"
                                    ng-disabled="optionsLoading || uploading">
                                <option value="">請選擇</option>
                                <option ng-repeat="item in companies track by item.Value"
                                        value="{{item.Value}}">{{item.Text}}</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-lg-2 col-md-3 col-form-label text-right">選擇檔案</label>
                        <div class="col-lg-8 col-md-9">
                            <input type="file"
                                   id="reconciliationLogisticsFile"
                                   class="form-control"
                                   accept="{{acceptedFileExtension}}"
                                   ng-disabled="uploading" />
                        </div>
                    </div>

                    <div class="loader loader-bar"
                         ng-class="{'is-active': uploading}"
                         data-rounded
                         data-text="檔案上傳中"></div>

                    <div class="mt-3" ng-if="uploadResult && !uploadSummary">
                        <div class="alert"
                             ng-class="{'alert-success': uploadResult.success, 'alert-danger': !uploadResult.success}">
                            {{uploadResult.message}}
                        </div>
                    </div>

                    <div class="mt-3" ng-if="uploadSummary">
                        <div class="d-flex justify-content-between align-items-start flex-wrap">
                            <div class="reconciliation-logistics-summary">
                                <div class="reconciliation-logistics-summary-card summary-source">
                                    <span class="label">上傳筆數</span>
                                    <span class="value">{{uploadSummary.Count}}</span>
                                </div>
                                <div class="reconciliation-logistics-summary-card summary-created">
                                    <span class="label">成功銷帳</span>
                                    <span class="value">{{uploadSummary.UpdatedCount}}</span>
                                </div>
                                <div class="reconciliation-logistics-summary-card summary-exception">
                                    <span class="label">異常筆數</span>
                                    <span class="value">{{uploadSummary.ExceptionCount}}</span>
                                </div>
                                <div class="reconciliation-logistics-summary-card summary-updated">
                                    <span class="label">更新費用資料</span>
                                    <span class="value">{{uploadSummary.UpdatedDetailCount}}</span>
                                </div>
                            </div>
                            <button type="button"
                                    class="btn btn-success"
                                    ng-if="downloadInfo"
                                    ng-click="downloadExcel()">
                                <i class="fa fa-download"></i> 下載Excel
                            </button>
                        </div>
                    </div>

                    <div ng-if="excelErrorMessage">
                        <div class="alert alert-warning">{{excelErrorMessage}}</div>
                    </div>

                    <div class="mt-3" ng-if="resultRows.length > 0">
                        <h5>異常明細（共 {{resultRows.length}} 筆）</h5>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>回款日期</th>
                                        <th>物流公司</th>
                                        <th>分提單號</th>
                                        <th>物流貨號</th>
                                        <th class="text-right">應收金額</th>
                                        <th class="text-right">回款金額</th>
                                        <th class="text-right">差異</th>
                                        <th>狀態</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in resultRows track by $index">
                                        <td>{{item.RepaymentDate}}</td>
                                        <td>{{item.Company}}</td>
                                        <td>{{item.TrackingNo}}</td>
                                        <td>{{item.DlvInv}}</td>
                                        <td class="text-right">{{item.ReceivableAmount | number:0}}</td>
                                        <td class="text-right">{{item.RepaymentAmount | number:0}}</td>
                                        <td class="text-right">{{item.Difference | number:0}}</td>
                                        <td class="text-danger">{{item.StatusName}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mt-3" ng-if="uploadData.length > 0">
                        <h5>欄位驗證失敗明細（共 {{uploadData.length}} 筆）</h5>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover">
                                <thead class="thead-dark">
                                    <tr>
                                        <th style="width:100px;">檔案列號</th>
                                        <th>失敗原因</th>
                                        <th>分提單號</th>
                                        <th>物流貨號</th>
                                        <th class="text-right">回款金額</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in uploadData track by $index">
                                        <td>{{item.RowNo}}</td>
                                        <td>{{item.FailReason}}</td>
                                        <td>{{item.TrackingNo}}</td>
                                        <td>{{item.DlvInv}}</td>
                                        <td class="text-right">{{item.ReceivedAmountText}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mt-3"
                         ng-if="uploadSummary && resultRows.length === 0 && uploadData.length === 0">
                        <div class="alert alert-info">本次上傳沒有失敗或未比對資料。</div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary"
                            ng-click="uploadFile()"
                            ng-disabled="uploading || optionsLoading">
                        <i class="fa"
                           ng-class="uploading ? 'fa-spinner fa-spin' : 'fa-upload'"></i>
                        {{uploading ? '上傳中...' : '上傳'}}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade reconciliation-logistics-upload-modal reconciliation-logistics-comparison-modal"
         id="reconciliationLogisticsComparisonModal"
         tabindex="-1"
         role="dialog"
         data-keyboard="false">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">比對物流銷帳明細</h5>
                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            ng-disabled="comparing"
                            aria-label="關閉">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group row">
                        <label class="col-lg-2 col-md-3 col-form-label text-right">物流公司</label>
                        <div class="col-lg-5 col-md-7">
                            <select class="form-control"
                                    ng-model="comparisonForm.company"
                                    ng-disabled="optionsLoading || comparing">
                                <option value="">請選擇</option>
                                <option ng-repeat="item in companies track by item.Value"
                                        value="{{item.Value}}">{{item.Text}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-lg-2 col-md-3 col-form-label text-right">選擇檔案</label>
                        <div class="col-lg-8 col-md-9">
                            <input type="file"
                                   id="reconciliationLogisticsComparisonFile"
                                   class="form-control"
                                   accept="{{comparisonAcceptedFileExtension}}"
                                   ng-disabled="comparing" />
                        </div>
                    </div>
                    <div class="loader loader-bar"
                         ng-if="comparing"
                         ng-class="{'is-active': comparing}"
                         data-rounded
                         data-text="檔案讀取中"></div>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary"
                            ng-click="compareDetail()"
                            ng-disabled="comparing || optionsLoading">
                        <i class="fa"
                           ng-class="comparing ? 'fa-spinner fa-spin' : 'fa-upload'"></i>
                        {{comparing ? '讀取中...' : '上傳'}}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .reconciliation-logistics-page .reconciliation-logistics-table-wrapper {
        margin-top: 1rem;
    }

    .reconciliation-logistics-page table th,
    .reconciliation-logistics-page table td {
        vertical-align: middle;
        white-space: nowrap;
    }

    .reconciliation-logistics-pagination {
        margin-top: 1.5rem;
    }

    .reconciliation-logistics-upload-modal .modal-dialog {
        width: calc(100% - 30px);
        max-width: 1200px;
    }

    .reconciliation-logistics-upload-modal .modal-body {
        height: 420px;
        max-height: calc(100vh - 170px);
        overflow-y: auto;
    }

    .reconciliation-logistics-comparison-modal .modal-dialog {
        max-width: 720px;
    }

    .reconciliation-logistics-comparison-modal .modal-body {
        height: auto;
        max-height: none;
        overflow-y: visible;
        padding: 1.25rem 1.5rem 0.5rem;
    }

    .reconciliation-logistics-comparison-modal .form-group {
        margin-bottom: 1rem;
    }

    .reconciliation-logistics-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 18px;
    }

    .reconciliation-logistics-summary-card {
        min-width: 170px;
        padding: 14px 18px;
        border-radius: 8px;
        background: #f5f7fa;
        border: 1px solid #d7dee6;
        border-left-width: 5px;
    }

        .reconciliation-logistics-summary-card .label {
            display: block;
            color: #6c757d;
            margin-bottom: 8px;
        }

        .reconciliation-logistics-summary-card .value {
            font-size: 24px;
            font-weight: 600;
            color: #1f2d3d;
        }

        .reconciliation-logistics-summary-card.summary-source {
            border-left-color: #2f80ed;
            background: #f2f7ff;
        }

        .reconciliation-logistics-summary-card.summary-created {
            border-left-color: #2fb344;
            background: #f0fbf3;
        }

        .reconciliation-logistics-summary-card.summary-exception {
            border-left-color: #e83e8c;
            background: #fff3f8;
        }

        .reconciliation-logistics-summary-card.summary-updated {
            border-left-color: #f2a900;
            background: #fff9ec;
        }

    @@media (max-width: 767.98px) {
        .reconciliation-logistics-page .form-group label {
            text-align: left !important;
        }
    }
</style>
