@model JETFTAX.Models.ErrorOrderSendCustomer.ErrorOrderSendCustomerViewModel

@using JETFTAX.Extensions
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script type="text/x-jquery-tmpl" id="errorOrderSendCustomerTmpl">
    <tr>

        <td>
            <input type="hidden" name="ErrorOrderSendCustomer.Index" value="${seq}" />
            <input type="hidden" name="ErrorOrderSendCustomer[${seq}].Id" value="${Id}" />
            ${Customer}
        </td>
        <td>${Platform}</td>
        <td>
            <button class="btn btn-danger" onclick="deleteCustomer('${Id}','${Customer}')">刪除</button>
        </td>
    </tr>
</script>

<span class="headtype">客戶相對應平台</span>
<hr />

<div class="col-12">
    客戶：
    <input type="text" id="customer" />
    平台：
    <input type="text" id="platform" />
    <div id="btntSearch" class="btn btn-success" onclick="create()" style="font-size: 1.2rem;"><i class="fas fa-search"></i> 新增</div>
</div>

<hr />
<div class="col-6">
    <table id="table" class="dataTable no-footer dtr-column" border="1">
        <thead>
            <tr>
                <th>客戶</th>
                <th>平台</th>
                <th>刪除</th>
            </tr>
        </thead>
    </table>
</div>

<!-- modal placeholder-->
<div id='myModal' class='modal fade in'>
    <div class="modal-dialog">
        <div class="modal-content" style="height:30rem;">
            <b class="item-close" onclick="$('#myModal').modal('hide');">x</b>
            <div id='myModalContent'></div>
        </div>
    </div>
</div>

<script>
    $('#collapseSend').addClass("show");
    $('#ErrorOrderSendCustomer').addClass("active");

    $(function () {
        if ('@Model.List.Count' != '0')
        {
            let itemList = (@Model.List.ToJsonRaw());

            for (i = 0; i < itemList.length; i++)
            {
                let data = itemList[i];
                data.seq = i + 1;
                $('#errorOrderSendCustomerTmpl').tmpl(data).appendTo('#table');
            }
        }
    })


    function create() {
        var customer = $('#customer').val().trim();
        var platform = $('#platform').val().trim();

        $.ajax({
            type: "POST",
            url: '@Url.Action("Create", "ErrorOrderSendCustomer")',
            data: {
                Customer: customer,
                Platform: platform
            },
            success: function (data) {
                if (data.status == "success") {
                    swal({
                        title: "新增成功",
                        icon: "success"
                    }).then(function () {
                        location.reload(); // 重新整理頁面
                    });
                } else {
                    swal({
                        title: data.msg,
                        icon: "error"
                    });
                }
            },
            error: function () {
                swal({
                    title: "新增失敗",
                    icon: "error"
                });
            }
        });
    }

    function deleteCustomer(id, customer) {
         swal({
        title: "確認刪除",
        text: `您確定要刪除${customer}？`,
        icon: "warning",
        buttons: true,
        dangerMode: true,
    }).then((willDelete) => {
        if (willDelete) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Delete", "ErrorOrderSendCustomer")',
                data: { id: id },
                success: function (data) {
                    if (data.status == "success") {
                        swal({
                            title: "刪除成功",
                            icon: "success"
                        }).then(function () {
                            location.reload(); // 重新整理頁面
                        });
                    } else {
                        swal({
                            title: data.msg,
                            icon: "error"
                        });
                    }
                },
                error: function () {
                    swal({
                        title: "刪除失敗",
                        icon: "error"
                    });
                }
            });
        }
    });

    }



</script>