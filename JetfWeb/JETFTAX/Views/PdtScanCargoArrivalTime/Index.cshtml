@{
    ViewBag.Title = "輸入外車交倉時間";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">輸入外車交倉時間</span>
<hr />

<div ng-controller="PdtScanCargoArrivalTimeController" class="containertype">
    <div class="card bg-light rounded p-4 mb-4" style="border:none">
        <!-- 日期 -->
        <div class="row mb-3 align-items-center">
            <div class="form-group row col-lg-12 mb-0 align-items-center">
                <label for="startDate" class="col-lg-1 col-form-label text-right">日期</label>
                <div class="col-lg-10">
                    <div class="d-flex" style="gap:8px; align-items:center; flex-wrap:nowrap;">
                        <input type="text"
                               id="startDate"
                               class="datepicker-input form-control"
                               style="max-width:200px;"
                               ng-model="searchForm.startDate"
                               ng-change="onDateChange()"
                               uib-datepicker-popup="yyyy-MM-dd"
                               datepicker-options="dateOptions"
                               is-open="startDatePopup.opened"
                               ng-click="openStartDatePopup()"
                               close-text="關閉"
                               current-text="今天"
                               show-button-bar="false"
                               readonly
                               placeholder="請選擇開始日期" />

                        <select class="form-control" style="max-width:80px;" ng-model="searchForm.startHour" ng-change="onDateChange()">
                            <option ng-repeat="h in hourOptions" ng-value="h">{{h}}</option>
                        </select>
                        <span>:</span>
                        <select class="form-control" style="max-width:80px;" ng-model="searchForm.startMinute" ng-change="onDateChange()">
                            <option ng-repeat="m in minuteOptions" ng-value="m">{{m}}</option>
                        </select>

                        <span style="white-space:nowrap;">~</span>

                        <input type="text"
                               id="endDate"
                               class="datepicker-input form-control"
                               style="max-width:200px;"
                               ng-model="searchForm.endDate"
                               ng-change="onDateChange()"
                               uib-datepicker-popup="yyyy-MM-dd"
                               datepicker-options="dateOptions"
                               is-open="endDatePopup.opened"
                               ng-click="openEndDatePopup()"
                               close-text="關閉"
                               current-text="今天"
                               show-button-bar="false"
                               readonly
                               placeholder="請選擇結束日期" />

                        <select class="form-control" style="max-width:80px;" ng-model="searchForm.endHour" ng-change="onDateChange()">
                            <option ng-repeat="h in hourOptions" ng-value="h">{{h}}</option>
                        </select>
                        <span>:</span>
                        <select class="form-control" style="max-width:80px;" ng-model="searchForm.endMinute" ng-change="onDateChange()">
                            <option ng-repeat="m in minuteOptions" ng-value="m">{{m}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- 作業地區 -->
        <div class="row mb-3 align-items-center">
            <div class="form-group row col-lg-12 mb-0 align-items-center">
                <label class="col-lg-1 col-form-label text-right">作業地區</label>
                <div class="col-lg-10">
                    <select class="form-control" ng-model="searchForm.dataType" ng-options="x.Value as x.Text for x in dataTypeList"></select>
                </div>
            </div>
        </div>

        <!-- 派件公司 -->
        <div class="row mb-3 align-items-center">
            <div class="form-group row col-lg-12 mb-0 align-items-center">
                <label class="col-lg-1 col-form-label text-right">派件公司</label>
                <div class="col-lg-10">
                    <select class="form-control" ng-model="searchForm.transNo" ng-options="x.Value as x.Text for x in transList"></select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <button type="button" class="btn btn-success col-lg-2 offset-1" ng-click="search()" ng-disabled="loading">
                    <i class="fas fa-search"></i>查詢
                </button>
            </div>
        </div>
    </div>

    <div class="loader loader-bar" ng-class="{'is-active': loading}" data-rounded data-text="處理中"></div>

    <div class="col-12 col-md-12 col-sm-12" ng-show="isSearched">
        <table class="table table-bordered table-striped" style="width:100%;">
            <thead>
                <tr>
                    <th>派件公司名稱</th>
                    <th>件數</th>
                    <th>已交倉時間件數</th>
                    <th>最後交倉時間</th>
                    <th>最後修改時間</th>
                    <th>最後編輯人員</th>
                    <th style="width:220px;">交倉時間</th>
                    <th style="width:100px;">更新</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="row in data">
                    <td>
                        <a href="javascript:void(0)" ng-click="openDetailDialog(row)">{{row.TransName}}</a>
                    </td>
                    <td>{{row.TotalCount}}</td>
                    <td>{{row.ArrivedCount}}</td>
                    <td>{{row.LastArrivalTime | customDateTime}}</td>
                    <td>{{row.LastUpdateArrivalTime | customDateTime}}</td>
                    <td>{{row.LastUpdateArrivalTimeOpe}}</td>
                    <td>
                        <input type="text" class="form-control" ng-model="row.ArrivalTimeInput" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-primary" ng-click="update(row)" ng-disabled="loading">更新</button>
                    </td>
                </tr>
                <tr ng-if="!data || data.length === 0">
                    <td colspan="8" style="text-align:center;">查無資料</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="pdtScanCargoArrivalTimeDetailDialog" tabindex="-1" role="dialog" aria-labelledby="pdtScanCargoArrivalTimeDetailDialogLabel" aria-hidden="true">
        <div class="modal-dialog" role="document" style="width:900px; max-width:95vw;">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="pdtScanCargoArrivalTimeDetailDialogLabel">派件公司：{{detail.transName}}</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" ng-click="closeDetailDialog()">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="loader loader-bar" ng-class="{'is-active': detail.loading}" data-rounded data-text="處理中"></div>

                    <table class="table table-bordered table-striped" style="width:100%;" ng-if="!detail.loading">
                        <thead>
                            <tr>
                                <th>交倉時間</th>
                                <th>交倉時間件數</th>
                                <th>更新交倉時間</th>
                                <th>更新交倉人員</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="d in detail.rows">
                                <td>{{d.ArrivalTime | customDateTime}}</td>
                                <td>{{d.ArrivedCount}}</td>
                                <td>{{d.UpdateArrivalTime | customDateTime}}</td>
                                <td>{{d.UpdateArrivalTimeOpe}}</td>
                            </tr>
                            <tr ng-if="!detail.rows || detail.rows.length === 0">
                                <td colspan="4" style="text-align:center;">查無資料</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
