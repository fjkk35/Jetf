@{
    ViewBag.Title = "Download";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">菜鳥海運超峰稅金</span>
<hr />
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="DownloadFileForm" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        <label for="DataDate">日　　期</label>
        <input id="DataDate" type="text" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>
    <div id="btntDownload" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem; "><i class="fas fa-download"></i> 下載</div>
    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</form>

@{
    <script>
        $('#collapseUpload').addClass("show");
        $('#CainiaoTaixinStarSeaTax').addClass("active");

        //日期
        $('#DataDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#btntDownload').click(function () {
            $('.loader').addClass("is-active");
            var dataDate = $('#DataDate').val();

            $.ajax({
                type: "POST",
                url: Router.action('CainiaoTaixinStarSeaTax', 'Download'),
                data: { 'dataDate': dataDate },
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                            $('.loader').removeClass("is-active");
                            return;
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') +
                                '?fileGuid=' + encodeURIComponent(data.fileGuid) +
                                '&filename=' + encodeURIComponent(data.fileName);

                            // 建立隱藏 <a> 並觸發下載
                            var link = document.createElement('a');
                            link.href = path;
                            link.download = data.fileName;
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);
                        }
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        })
    </script>

}
