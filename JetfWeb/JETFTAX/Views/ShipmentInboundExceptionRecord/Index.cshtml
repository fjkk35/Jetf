@{
    ViewBag.Title = "異常紀錄查詢";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .exception-record-table-container {
        max-height: 600px;
        overflow: auto;
        border: 1px solid #dee2e6;
    }

        .exception-record-table-container table {
            min-width: 100%;
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

        .exception-record-table-container thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #343a40;
            color: #fff;
        }

        .exception-record-table-container td,
        .exception-record-table-container th {
            padding: 8px;
            vertical-align: middle;
            border: 1px solid #dee2e6;
            white-space: normal;
            word-break: break-all;
        }

        .exception-record-table-container tbody tr:nth-of-type(odd) {
            background-color: #f2f2f2;
        }

        .exception-record-table-container tbody tr:hover {
            background-color: #f5f5f5;
        }

    .exception-record-col-date {
        width: 160px;
        white-space: nowrap;
        word-break: normal;
    }

    .exception-record-col-main,
    .exception-record-col-customer,
    .exception-record-col-tracking {
        width: 220px;
    }

    .exception-record-result {
        padding: 0 18px 18px;
        box-sizing: border-box;
    }

    .exception-reason-selector-input {
        cursor: pointer;
        background-color: #fff;
    }

        .exception-reason-selector-input[readonly] {
            background-color: #fff;
        }

    .exception-reason-modal .modal-dialog {
        width: 90%;
        max-width: 720px;
    }

    .exception-reason-modal .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .exception-reason-modal .modal-title {
        margin: 0;
        color: #666;
        text-align: left;
        flex: 1;
    }

    .exception-reason-modal .close {
        float: none;
        margin: 0 0 0 16px;
        padding: 0;
        line-height: 1;
    }

    .exception-reason-toolbar {
        margin-bottom: 18px;
    }

        .exception-reason-toolbar label {
            padding: 6px 4px;
        }

        .exception-reason-toolbar label,
        .exception-reason-grid .exception-reason-item label {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            cursor: pointer;
            user-select: none;
        }

    .exception-reason-checkbox {
        margin: 0 8px 0 0;
        vertical-align: middle;
        transform: scale(1.4);
        -webkit-transform: scale(1.4);
        -ms-transform: scale(1.4);
        transform-origin: center center;
        -webkit-transform-origin: center center;
    }

    .exception-reason-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
    }

        .exception-reason-grid .exception-reason-item {
            width: calc((100% - 24px) / 3);
            min-width: 180px;
        }

        .exception-reason-grid .exception-reason-item label {
            padding: 6px 4px;
            width: 100%;
            box-sizing: border-box;
        }

        .exception-reason-grid .exception-reason-item input[type=checkbox] {
            margin: 0 8px 0 0;
        }

    @@media (max-width: 767px) {
        .exception-reason-grid .exception-reason-item {
            width: 100%;
            min-width: 100%;
        }
    }
</style>

<div ng-controller="ShipmentInboundExceptionRecordController">
    <span class="headtype">異常紀錄查詢</span>
    <hr />

    <div class="card bg-light rounded p-4 mb-4" style="border:none">
        <div class="row mb-3 align-items-center">
            <div class="form-group row col-lg-3 mb-0">
                <label for="exceptionInboundDateStart" class="col-lg-4 col-form-label text-right">入庫日期(起)</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="exceptionInboundDateStart"
                           class="datepicker-input form-control"
                           ng-model="searchForm.inboundDateStart"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="startDatePopup.opened"
                           ng-click="openStartDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           placeholder="請選擇開始日期" />
                </div>
            </div>

            <div class="form-group row col-lg-3 mb-0">
                <label for="exceptionInboundDateEnd" class="col-lg-4 col-form-label text-right">入庫日期(迄)</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="exceptionInboundDateEnd"
                           class="datepicker-input form-control"
                           ng-model="searchForm.inboundDateEnd"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="endDatePopup.opened"
                           ng-click="openEndDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           placeholder="請選擇結束日期" />
                </div>
            </div>

            <div class="form-group row col-lg-3 mb-0">
                <label for="exceptionMainNumber" class="col-lg-4 col-form-label text-right">主號</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="exceptionMainNumber"
                           class="form-control"
                           ng-model="searchForm.mainNumber"
                           placeholder="請輸入主號" />
                </div>
            </div>

            <div class="form-group row col-lg-3 mb-0">
                <label for="exceptionTrackingNo" class="col-lg-4 col-form-label text-right d-flex align-items-center justify-content-end">單號</label>
                <div class="col-lg-8">
                    <textarea id="exceptionTrackingNo"
                              class="form-control"
                              rows="3"
                              ng-model="searchForm.trackingNo"
                              placeholder="請輸入單號，可換行輸入多筆"
                              style="resize:vertical;"></textarea>
                </div>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <div class="form-group row col-lg-3 mb-0">
                <label for="exceptionCustCode" class="col-lg-4 col-form-label text-right">客戶</label>
                <div class="col-lg-8">
                    <customer-multi-select
                        select-all="customerSelectAll"
                        selected-cust-codes="selectedCustCodes"
                        display-text="customerDisplayText"
                        display-full-text="customerDisplayFullText">
                    </customer-multi-select>
                </div>
            </div>

            <div class="form-group row col-lg-3 mb-0">
                <label for="exceptionReason" class="col-lg-4 col-form-label text-right">異常原因</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="exceptionReason"
                           class="form-control exception-reason-selector-input"
                           ng-model="exceptionReasonDisplayText"
                           ng-attr-title="{{exceptionReasonDisplayFullText}}"
                           ng-click="openExceptionReasonModal()"
                           readonly
                           placeholder="請點選異常原因" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 text-right">
                <button type="button"
                        class="btn btn-primary"
                        ng-click="search()"
                        ng-disabled="loading || exporting">
                    <i class="fa fa-search"></i> 查詢
                </button>
                <button type="button"
                        class="btn btn-secondary ml-2"
                        ng-click="clearSearch()"
                        ng-disabled="loading || exporting">
                    <i class="fa fa-eraser"></i> 清除
                </button>
                <button type="button"
                        class="btn btn-success ml-2"
                        ng-click="exportExcel()"
                        ng-disabled="loading || exporting">
                    <i class="fa fa-download"></i> 匯出Excel
                </button>
            </div>
        </div>
    </div>

    <hr />

    <div ng-show="loading || exporting" class="text-center">
        <i class="fa fa-spinner fa-spin fa-3x"></i>
        <p>{{exporting ? '匯出中...' : '載入中...'}}</p>
    </div>

    <div class="exception-record-result" ng-show="isSearched && !loading">
        <div class="row mb-2">
            <div class="col-lg-6">
                <div class="form-inline">
                    <label class="mr-2">每頁顯示</label>
                    <select class="form-control"
                            ng-model="pageSize"
                            ng-change="changePageSize()">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <label class="ml-2">筆</label>
                </div>
            </div>
            <div class="col-lg-6 text-right">
                <span>{{recordsInfo}}</span>
            </div>
        </div>

        <div class="exception-record-table-container mt-3">
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th class="exception-record-col-date">入庫日期</th>
                        <th class="exception-record-col-customer">客戶</th>
                        <th class="exception-record-col-main">主號</th>
                        <th class="exception-record-col-tracking">單號</th>
                        <th>異常原因</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-if="data.length === 0">
                        <td colspan="5" class="text-center">查無資料</td>
                    </tr>
                    <tr ng-repeat="item in data">
                        <td class="exception-record-col-date">{{item.InboundDate | customDate}}</td>
                        <td class="exception-record-col-customer">{{item.CustName || item.CustCode}}</td>
                        <td class="exception-record-col-main">{{item.MainNumber}}</td>
                        <td class="exception-record-col-tracking">
                            <a href="~/ShipmentInboundRecord/Detail?id={{item.Id}}"
                               target="_blank"
                               class="text-primary"
                               style="cursor:pointer;text-decoration:underline;font-weight:600;">
                                {{item.TrackingNo}}
                            </a>
                        </td>
                        <td>{{item.ExceptionReason}}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="row mt-3" ng-show="totalPages > 1">
            <div class="col-lg-12">
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item" ng-class="{disabled: currentPage === 1}">
                            <a class="page-link" href="javascript:void(0)" ng-click="previousPage()">上一頁</a>
                        </li>
                        <li class="page-item"
                            ng-repeat="page in getPages()"
                            ng-class="{active: page === currentPage}">
                            <a class="page-link" href="javascript:void(0)" ng-click="changePage(page)">{{page}}</a>
                        </li>
                        <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                            <a class="page-link" href="javascript:void(0)" ng-click="nextPage()">下一頁</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <div class="modal fade exception-reason-modal" id="exceptionReasonSelectModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">異常原因選擇</h4>
                    <button type="button" class="close" ng-click="closeExceptionReasonModal()" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="exception-reason-toolbar" ng-if="exceptionReasonList.length > 0">
                        <label>
                            <input type="checkbox"
                                   class="exception-reason-checkbox"
                                   ng-model="exceptionReasonSelectAll"
                                   ng-click="toggleAllExceptionReasons($event)" />
                            <span>全選</span>
                        </label>
                    </div>

                    <div class="exception-reason-grid" ng-if="exceptionReasonList.length > 0">
                        <div class="exception-reason-item" ng-repeat="reason in exceptionReasonList track by reason.Value">
                            <label ng-attr-title="{{reason.Text}}">
                                <input type="checkbox"
                                       class="exception-reason-checkbox"
                                       ng-model="exceptionReasonModal.selectedMap[reason.Value]"
                                       ng-change="onExceptionReasonItemChanged()" />
                                <span>{{reason.Text}}</span>
                            </label>
                        </div>
                    </div>

                    <div ng-if="exceptionReasonList.length === 0" class="text-center text-muted py-3">
                        查無異常原因清單
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
