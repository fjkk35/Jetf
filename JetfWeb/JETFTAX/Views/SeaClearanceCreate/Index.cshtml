@{
    ViewBag.Title = "UploadFile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="SeaClearanceCreateController">
    <span class="headtype">海快後段報關建檔</span>
    <hr />

    <form id="UploadFileForm" action="@Url.Action("UploadFile", "SeaClearanceCreate")" method="post" enctype="multipart/form-data" class="containertype">
        <div class="col-lg-12" style="margin-bottom:0.5rem;">
            <label for="DataDate">日　　期</label>
            <input type="text"
                   id="DataDate"
                   name="dataDate"
                   class="datepicker-input form-control"
                   ng-model="dataDate"
                   uib-datepicker-popup="yyyy-MM-dd"
                   datepicker-options="dateOptions"
                   is-open="dataDatePopup.opened"
                   ng-click="openDataDatePopup()"
                   close-text="關閉"
                   current-text="今天"
                   show-button-bar="false"
                   readonly
                   placeholder="請選擇日期" />
        </div>
        <div class="col-lg-12" style="margin:0.5rem 0;">
            <input type="file" name="file" id="fileTax" />
        </div>
        <div class="col-lg-12" style="margin:0.5rem 0;">
            <a href='~/Download/DownloadExample?filePath=@AppDomain.CurrentDomain.BaseDirectory\Download\海快後段報關建檔_範例.xlsx&fileName=海快後段報關建檔_範例.xlsx' target='_blank'>下載範例</a>
        </div>
        <button type="button" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;" ng-click="uploadFile()" ng-disabled="loading">
            <i class="fas fa-upload"></i> 上傳
        </button>
    </form>

    <div class="col-12" style="margin-top: 20px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center">
                <span class="mr-2">每頁顯示：</span>
                <select class="form-control form-control-sm"
                        style="width: 80px;"
                        ng-model="pageSize"
                        ng-change="changePageSize()">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <span class="ml-3">{{recordsInfo}}</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th>Id</th>
                        <th>檔名</th>
                        <th>上傳人員</th>
                        <th>時間</th>
                        <th>明細</th>
                        <th>上傳結果</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-if="loading">
                        <td colspan="6" class="text-center">
                            <i class="fas fa-spinner fa-spin"></i> 載入中...
                        </td>
                    </tr>
                    <tr ng-if="!loading && data.length === 0">
                        <td colspan="6" class="text-center">查無資料</td>
                    </tr>
                    <tr ng-repeat="item in data track by item.Id" ng-if="!loading">
                        <td>{{item.Id}}</td>
                        <td>{{item.FileName || ''}}</td>
                        <td>{{item.UploadOpe || ''}}</td>
                        <td>{{item.CrtDateTime | customDateTime:'YYYY-MM-DD HH:mm:ss'}}</td>
                        <td>
                            <button class="btn btn-success" ng-click="download(item.Id)" ng-disabled="loading">下載檔案</button>
                        </td>
                        <td>
                            <button class="btn btn-info" ng-click="uploadResult(item.Id)" ng-disabled="loading">上傳結果</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-center mt-3" ng-if="totalPages > 1">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item" ng-class="{disabled: currentPage === 1}">
                        <a class="page-link" href="javascript:void(0)" ng-click="goToPage(1)">第一頁</a>
                    </li>
                    <li class="page-item" ng-class="{disabled: currentPage === 1}">
                        <a class="page-link" href="javascript:void(0)" ng-click="previousPage()">上一頁</a>
                    </li>
                    <li class="page-item"
                        ng-repeat="page in getPageNumbers()"
                        ng-class="{active: page === currentPage}">
                        <a class="page-link" href="javascript:void(0)" ng-click="goToPage(page)">{{page}}</a>
                    </li>
                    <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                        <a class="page-link" href="javascript:void(0)" ng-click="nextPage()">下一頁</a>
                    </li>
                    <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                        <a class="page-link" href="javascript:void(0)" ng-click="goToPage(totalPages)">最後一頁</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="uploadResultModal" tabindex="-1" role="dialog" aria-labelledby="uploadResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="uploadResultModalLabel">上傳結果</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th>作業日</th>
                                    <th>主提單號</th>
                                    <th>分提單號</th>
                                    <th>上傳結果</th>
                                    <th>原因</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-if="uploadResults.length === 0">
                                    <td colspan="5" class="text-center">查無資料</td>
                                </tr>
                                <tr ng-repeat="item in uploadResults track by $index">
                                    <td>{{item.DataDate || ''}}</td>
                                    <td>{{item.MainNumber || ''}}</td>
                                    <td>{{item.TrackingNo || ''}}</td>
                                    <td>
                                        <span class="badge badge-success" ng-if="item.IsSucess">成功</span>
                                        <span class="badge badge-danger" ng-if="!item.IsSucess">失敗</span>
                                    </td>
                                    <td>{{item.Memo || ''}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">關閉</button>
                </div>
            </div>
        </div>
    </div>

    <div class="loader loader-bar" ng-class="{'is-active': loading}" data-rounded data-text="處理中"></div>
</div>
