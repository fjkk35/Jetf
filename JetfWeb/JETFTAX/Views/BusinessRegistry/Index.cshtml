
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">營業登記</span>
<hr />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="DownloadFileForm" action="@Url.Action("", "")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:1.5rem;">
        <a href="https://data.gov.tw/dataset/9400">全國營業(稅籍)登記資料集</a>
    </div>
    <div class="col-lg-12" style="margin:0.5rem 0;">
        統一編號:
        <div>
            <textarea id="txtBusinessId" style="height:300px"></textarea>
        </div>
    </div>
    <div id="btntDownloadFile" type="button" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-download"></i> 下載</div>

    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</form>

@{
    <script>
        $('#collapseSearch').addClass("show");
        $('#BusinessRegistry').addClass("active");

        $('#btntDownloadFile').click(function () {
            let businessId = $('#txtBusinessId').val();
            if (businessId == "") {
                swal({
                    title: "請輸入統一編號",
                    icon: "error"
                });
                return;
            }

            $('.loader').addClass("is-active");

            var postData = new FormData($('#DownloadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('BusinessRegistry', 'GetExcel'),
                data: { "businessId": $('#txtBusinessId').val() },
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                + '&filename=' + data.fileName;
                            //window.location = path;
                            window.open(path);

                        }
                    }
                    file.outerHTML = file.outerHTML; //重置了file的outerHTML
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        })

    </script>

}
