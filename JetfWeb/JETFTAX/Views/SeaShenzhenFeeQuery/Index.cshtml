@{
    ViewBag.Title = "稅金資料查詢";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .sea-shenzhen-fee-query-table-container {
        max-height: 620px;
        overflow: auto;
        border: 1px solid #dee2e6;
    }

        .sea-shenzhen-fee-query-table-container table {
            min-width: 1400px;
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

        .sea-shenzhen-fee-query-table-container thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #343a40;
            color: #fff;
            white-space: nowrap;
        }

        .sea-shenzhen-fee-query-table-container td,
        .sea-shenzhen-fee-query-table-container th {
            padding: 8px;
            vertical-align: middle;
            border: 1px solid #dee2e6;
            white-space: normal;
            word-break: break-all;
        }

        .sea-shenzhen-fee-query-table-container tbody tr:nth-of-type(odd) {
            background-color: #f7f7f7;
        }

        .sea-shenzhen-fee-query-table-container tbody tr:hover {
            background-color: #eef5ff;
        }

    .sea-shenzhen-fee-query-result {
        padding: 0 18px 18px;
        box-sizing: border-box;
    }
</style>

<div ng-controller="SeaShenzhenFeeQueryController">
    <span class="headtype">稅金資料查詢</span>
    <hr />

    <div class="card bg-light rounded p-4 mb-4" style="border:none">
        <div class="row mb-3 align-items-center">
            <div class="form-group row col-lg-3 mb-0">
                <label for="seaShenzhenFeeDataDateStart" class="col-lg-4 col-form-label text-right">日期(起)</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="seaShenzhenFeeDataDateStart"
                           class="datepicker-input form-control"
                           ng-model="searchForm.dataDateStart"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="startDatePopup.opened"
                           ng-click="openStartDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           placeholder="請選擇開始日期" />
                </div>
            </div>

            <div class="form-group row col-lg-3 mb-0">
                <label for="seaShenzhenFeeDataDateEnd" class="col-lg-4 col-form-label text-right">日期(迄)</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="seaShenzhenFeeDataDateEnd"
                           class="datepicker-input form-control"
                           ng-model="searchForm.dataDateEnd"
                           uib-datepicker-popup="yyyy-MM-dd"
                           datepicker-options="dateOptions"
                           is-open="endDatePopup.opened"
                           ng-click="openEndDatePopup()"
                           close-text="關閉"
                           current-text="今天"
                           show-button-bar="false"
                           readonly
                           placeholder="請選擇結束日期" />
                </div>
            </div>

            <div class="form-group row col-lg-3 mb-0">
                <label for="seaShenzhenFeeTrackingNo" class="col-lg-4 col-form-label text-right">分提單號</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="seaShenzhenFeeTrackingNo"
                           class="form-control"
                           ng-model="searchForm.trackingNo"
                           placeholder="請輸入分提單號" />
                </div>
            </div>

            <div class="form-group row col-lg-3 mb-0">
                <label for="seaShenzhenFeeDlvInv" class="col-lg-4 col-form-label text-right">物流貨號</label>
                <div class="col-lg-8">
                    <input type="text"
                           id="seaShenzhenFeeDlvInv"
                           class="form-control"
                           ng-model="searchForm.dlvInv"
                           placeholder="請輸入物流貨號" />
                </div>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <div class="form-group row col-lg-3 mb-0">
                <label for="seaShenzhenFeeIncludeTax" class="col-lg-4 col-form-label text-right">稅金支付方式</label>
                <div class="col-lg-8">
                    <select id="seaShenzhenFeeIncludeTax"
                            class="form-control"
                            ng-model="searchForm.includeTax"
                            ng-options="item.Value as item.Text for item in taxPaymentOptions">
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 text-right">
                <button type="button"
                        class="btn btn-primary"
                        ng-click="search()"
                        ng-disabled="loading || exporting">
                    <i class="fa fa-search"></i> 查詢
                </button>
                <button type="button"
                        class="btn btn-secondary ml-2"
                        ng-click="clearSearch()"
                        ng-disabled="loading || exporting">
                    <i class="fa fa-eraser"></i> 清除
                </button>
                <button type="button"
                        class="btn btn-success ml-2"
                        ng-click="exportExcel()"
                        ng-disabled="loading || exporting">
                    <i class="fa fa-file-excel-o"></i> 下載Excel
                </button>
            </div>
        </div>
    </div>

    <hr />

    <div ng-show="loading" class="text-center">
        <i class="fa fa-spinner fa-spin fa-3x"></i>
        <p>載入中...</p>
    </div>

    <div class="sea-shenzhen-fee-query-result" ng-show="isSearched && !loading">
        <div class="row mb-2">
            <div class="col-lg-6">
                <div class="form-inline">
                    <label class="mr-2">每頁顯示</label>
                    <select class="form-control"
                            ng-model="pageSize"
                            ng-change="changePageSize()">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <label class="ml-2">筆</label>
                </div>
            </div>
            <div class="col-lg-6 text-right">
                <span>{{recordsInfo}}</span>
            </div>
        </div>

        <div class="sea-shenzhen-fee-query-table-container mt-3">
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>序號</th>
                        <th>日期</th>
                        <th>客戶</th>
                        <th>派件公司</th>
                        <th>分提單號</th>
                        <th>物流貨號</th>
                        <th>稅金支付方式</th>
                        <th>稅金</th>
                        <th>到付款</th>
                        <th>手續費</th>
                        <th>物流代收金額</th>
                        <th>人工調整物流代收金額</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-if="data.length === 0">
                        <td colspan="12" class="text-center">查無資料</td>
                    </tr>
                    <tr ng-repeat="item in data track by item.Id">
                        <td>{{(currentPage - 1) * parsePageSize() + $index + 1}}</td>
                        <td>{{item.DataDateText}}</td>
                        <td>{{item.CustomerName}}</td>
                        <td>{{item.DlvCom}}</td>
                        <td>{{item.TrackingNo}}</td>
                        <td>{{item.DlvInv}}</td>
                        <td>{{item.IncludeTaxDisplay}}</td>
                        <td>{{item.Tax}}</td>
                        <td>{{item.Cod}}</td>
                        <td>{{item.Fee}}</td>
                        <td>{{item.ToDlvCod}}</td>
                        <td>{{item.ManualToDlvCod}}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="row mt-3" ng-show="totalPages > 1">
            <div class="col-lg-12">
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item" ng-class="{disabled: currentPage === 1}">
                            <a class="page-link" href="javascript:void(0)" ng-click="previousPage()">上一頁</a>
                        </li>
                        <li class="page-item"
                            ng-repeat="page in getPages()"
                            ng-class="{active: page === currentPage}">
                            <a class="page-link" href="javascript:void(0)" ng-click="changePage(page)">{{page}}</a>
                        </li>
                        <li class="page-item" ng-class="{disabled: currentPage === totalPages}">
                            <a class="page-link" href="javascript:void(0)" ng-click="nextPage()">下一頁</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
