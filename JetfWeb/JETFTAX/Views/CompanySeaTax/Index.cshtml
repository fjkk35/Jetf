@model JETFTAX.Models.CompanySeaTax.CompanySeaTaxViewModel

@{
    ViewBag.Title = "Download";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">物流公司海運稅金</span>
<hr />
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="DownloadFileForm" action="@Url.Action("SeaExcel", "CompanySeaTax")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.DataDate)
        @Html.TextBoxFor(m => m.DataDate, new { @class = "form-control" })
    </div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.CompanyList)
        @Html.DropDownListFor(m => m.Company, Model.CompanyList, new { @class = "form-control" })
    </div>
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.TaxTypeList)
        @Html.DropDownListFor(m => m.TaxType, Model.TaxTypeList, new { @class = "form-control" })
    </div>
    <div id="btntDownload" type="submit" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-download"></i> 下載</div>
    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</form>
@{
    <script>
        $('#collapseUpload').addClass("show");
        $('#CompanySeaTax').addClass("active");

        //日期
        $('#DataDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#btntDownload').click(function () {
            //$("#DownloadFileForm").submit();
            $('.loader').addClass("is-active");
            var postData = new FormData($('#DownloadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('CompanySeaTax', 'SeaExcel'),
                data: postData,
                cache: false,
                dataType: 'json',
                processData: false,
                //async: false,
                contentType: false,
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }

                    if (data.msg != "") {
                        swal({
                            title: data.msg,
                            icon: "error"
                        });
                        return;
                    }

                    if (data.fileName != "") {
                        var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                            + '&filename=' + data.fileName;
                        //window.location = path;
                        window.open(path);
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            })
        });
    </script>

}
