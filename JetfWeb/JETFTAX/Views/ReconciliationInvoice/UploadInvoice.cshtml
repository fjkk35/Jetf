@{
    ViewBag.Title = "代收銷帳上傳發票";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .upload-invoice-page {
        padding: 0 18px 18px;
        box-sizing: border-box;
    }

</style>

<div class="upload-invoice-page" ng-controller="ReconciliationUploadInvoiceController">
    <span class="headtype">代收銷帳上傳發票</span>
    <hr />

    <div class="containertype">
        <div class="form-group row">
            <label class="col-lg-1 col-md-3 col-sm-12 control-label" style="padding-top:7px;">選擇 Excel 檔案</label>
            <div class="col-lg-6 col-md-7 col-sm-12" style="margin-bottom:0.5rem;">
                <input type="file" id="uploadInvoiceFileInput" accept=".xlsx" class="form-control" />
            </div>
        </div>

        <div class="form-group row" style="margin-bottom:0;">
            <div class="col-lg-offset-2 col-md-offset-3 col-lg-10 col-md-9 col-sm-12" style="margin:0.5rem 0;">
                <a href='~/Download/DownloadExample?filePath=@AppDomain.CurrentDomain.BaseDirectory\Download\代收銷帳上傳發票_範例.xlsx&fileName=代收銷帳上傳發票_範例.xlsx' target='_blank'>下載範例</a>
            </div>
        </div>

        <div class="form-group row" style="margin-bottom:0;">
            <div class="col-lg-offset-2 col-md-offset-3 col-lg-10 col-md-9 col-sm-12" style="margin:0.5rem 0;">
                <button type="button" class="btn btn-primary confirmbtn" ng-click="uploadFile()" ng-disabled="uploading">
                    <i class="fas fa-upload"></i> {{ uploading ? '上傳中...' : '上傳' }}
                </button>
            </div>
        </div>

        <div class="loader loader-bar" ng-class="{'is-active': uploading}" data-rounded data-text="檔案上傳中"></div>

        <div class="col-lg-12" style="margin-top:1rem;" ng-if="uploadResult">
            <div class="alert" ng-class="{'alert-success': uploadResult.success, 'alert-danger': !uploadResult.success}">
                {{ uploadResult.message }}
            </div>
        </div>

        <div class="col-lg-12" style="margin-top:1rem;" ng-if="uploadData.length > 0">
            <h4>失敗明細（共 {{ uploadData.length }} 筆）</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Excel 列號</th>
                            <th>失敗原因</th>
                            <th>發票類別</th>
                            <th>開立日期</th>
                            <th>發票號碼</th>
                            <th>分提單號</th>
                            <th>物流貨號</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in uploadData track by $index">
                            <td>{{ item.RowNo }}</td>
                            <td>{{ item.FailReason }}</td>
                            <td>{{ item.InvoiceType }}</td>
                            <td>{{ item.InvoiceDateText }}</td>
                            <td>{{ item.InvoiceNo }}</td>
                            <td>{{ item.TrackingNo }}</td>
                            <td>{{ item.DlvInv }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
