@model JETFTAX.Models.SeataxViewModel
@{
    /**/

    ViewBag.Title = "GSeatax";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">G類資料上傳</span>
<hr />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="UploadFileForm" action="@Url.Action("UploadFileG", "Upload")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.date)
        @Html.TextBoxFor(m => m.date, new { @class = "form-control" })
    </div>
    @*<div class="col-lg-12">
        @Html.LabelFor(m => m.ddlTaxTypeList)
        @Html.DropDownListFor(m => m.taxType, Model.ddlTaxTypeList, new { @class = "form-control" })
    </div>*@
    <div class="col-lg-12" style="margin:0.5rem 0;">
        <input type="file" name="file" id="fileTax" />
    </div>
    <div id="btntUploadFile" type="button" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-upload"></i> 上傳</div>

    <div class="loader loader-bar" data-rounded data-text="檔案上傳中"></div>
</form>
@{
    <script>
        $('#collapseUpload').addClass("show");
        $('#SeataxG').addClass("active");

        //日期
        $('#date').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd' });
        });

        $('#btntUploadFile').click(function () {
            $('.loader').addClass("is-active");

            var file = document.getElementById('fileTax');
            var postData = new FormData($('#UploadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('Upload', 'UploadFileG'),
                data: postData,
                cache: false,
                dataType: 'json',
                processData: false,
                //async: false,
                contentType: false,
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.status == "success") {
                            swal({
                                title: data.msg,
                                icon: "success"
                            });
                        }
                        else {
                            //顯示錯誤資訊
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        file.outerHTML = file.outerHTML; //重置了file的outerHTML
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        })
    </script>

}