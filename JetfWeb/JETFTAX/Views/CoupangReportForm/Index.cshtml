@{
    ViewBag.Title = "批量查詢Coupang";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">批量查詢Coupang</span>
<hr />

<div ng-controller="CoupangReportFormController" class="containertype">
    <form id="coupangReportUploadForm" enctype="multipart/form-data">
        <div class="col-lg-12" style="margin:0.5rem 0;">
            <input type="file" name="file" id="coupangReportFile" accept=".xlsx" />
        </div>

        <button type="button"
                id="btnCoupangReportUpload"
                class="btn btn-primary confirmbtn col-lg-3"
                style="font-size: 1.2rem;"
                ng-click="upload()"
                ng-disabled="isLoading">
            <i class="fas fa-upload"></i> 上傳並下載
        </button>

        <div class="loader loader-bar" data-rounded data-text="檔案處理中" ng-class="{ 'is-active': isLoading }"></div>
    </form>
</div>
