@using Service.EnumTax
@using Newtonsoft.Json
<!DOCTYPE html>
<html lang="en" ng-app="mainApp">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>進口快遞管理系統</title>
    <link href="~/Scripts/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/Content/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/Content/css-loader.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/jquery-ui.css">
    @Styles.Render("~/Content/DataTables/media/css/jquery.dataTables.min.css")
    @Styles.Render("~/Content/DataTables/extensions/Responsive/css/responsive.dataTables.min.css")
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <style>
        .hidden { display: none !important; }
        .menu-group-icon { width: 18px; text-align: center; }
        [ng-cloak] { display: none !important; }
        .glyphicon {
            font-family: "Font Awesome 5 Free";
            font-weight: 900;
            font-style: normal;
        }
        .glyphicon-chevron-left:before { content: "\f053"; }
        .glyphicon-chevron-right:before { content: "\f054"; }
    </style>
</head>
@{
    var partners = Session["user_partner"] as List<string> ?? new List<string>();
    var authorities = Session["user_auth"] as List<string> ?? new List<string>();
    var partnersJson = JsonConvert.SerializeObject(partners);
    var authoritiesJson = JsonConvert.SerializeObject(authorities);
    var userName = Session["user_name"].ToString() ?? string.Empty;
}
<body id="page-top" ng-controller="LayoutController" ng-cloak>
    <script>
        window.UserCtx = {
            partners: @Html.Raw(partnersJson),
            authorities: @Html.Raw(authoritiesJson),
            userName: @Html.Raw(JsonConvert.SerializeObject(userName))
        };
    </script>
    
    <div id="wrapper">
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="">
                <div class="sidebar-brand-icon rotate-n-15"><i class="fas fa-funnel-dollar"></i></div>
                <div class="sidebar-brand-text mx-3">進口快遞<br />管理系統</div>
            </a>
            <hr class="sidebar-divider my-0">
            <hr class="sidebar-divider">
            <li class="nav-item" ng-repeat="group in visibleMenus">
                <a class="nav-link collapsed" ng-class="{active: group.isActive}" href="#"
                   data-toggle="collapse" data-target="#collapse_{{group.id}}"
                   aria-expanded="{{group.isActive}}" aria-controls="collapse_{{group.id}}">
                    <i ng-class="group.icon"></i><span>{{group.title}}</span>
                </a>
                <div id="collapse_{{group.id}}" class="collapse" ng-class="{show: group.isActive}" data-parent="#accordionSidebar">
                    <div class="bg-white py-2 collapse-inner rounded">
                        <a ng-repeat="item in group.visibleChildren"
                           id="{{item.id}}"
                           class="collapse-item"
                           ng-class="{active: item.isActive}"
                           ng-style="item.styleObj"
                           href="{{item.url}}">{{item.text}}</a>
                    </div>
                </div>
            </li>
        </ul>
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3"><i class="fa fa-bars"></i></button>
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item dropdown no-arrow mx-1"><div class="jclock" style="padding: 1.5rem;"></div></li>
                        <div class="topbar-divider d-none d-sm-block"></div>
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">{{userName}}</span>
                                <img class="img-profile rounded-circle" src="~/img/undraw_profile.svg">
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#logoutModal"><i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>登出</a>
                            </div>
                        </li>
                    </ul>
                </nav>
                @RenderBody()
            </div>
            <footer class="sticky-footer bg-white">
                <div class="container my-auto"><div class="copyright text-center my-auto"><span>Copyright &copy; Your Website 2021</span></div></div>
            </footer>
        </div>
    </div>
    <a class="scroll-to-top rounded" href="#page-top"><i class="fas fa-angle-up"></i></a>
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="exampleModalLabel">確認登出?</h5><button class="close" type="button" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button></div>
                <div class="modal-body">登出</div>
                <div class="modal-footer"><button class="btn btn-secondary" type="button" data-dismiss="modal">取消</button><a class="btn btn-primary" href="~/Account/LogOff">登出</a></div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/vendor/jquery/jquery.min.js"></script>
    <script src="~/Scripts/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/Scripts/js/sb-admin-2.min.js"></script>
    <script src="~/Scripts/lib/jquery.jclock.js"></script>
    @Scripts.Render("~/Scripts/lib/DatePicker/WdatePicker.js")
    @Scripts.Render("~/Scripts/lib/sweetalert.min.js")
    @Scripts.Render("~/Scripts/lib/jquery.tmpl.js")
    @Scripts.Render(RouteJs.RouteJsHandler.HandlerUrl)
    @Scripts.Render("~/Scripts/DataTables/media/js/jquery.dataTables.min.js")
    @Scripts.Render("~/Scripts/DataTables/extensions/Responsive/js/dataTables.responsive.min.js")
    @Scripts.Render("~/Scripts/DataTables/extensions/FixedHeader/js/dataTables.fixedHeader.min.js")
    @Scripts.Render("~/Scripts/lib/jquery.twbsPagination.min.js")
    @Scripts.Render("~/bundles/angular")
    <script src="~/Scripts/lib/jquery-ui.min.js"></script>
    <script src="~/Scripts/lib/angular/sortable.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
