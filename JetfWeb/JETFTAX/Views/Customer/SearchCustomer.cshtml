
@{
    ViewBag.Title = "SearchCustomer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">客戶查詢</span>
<hr />
<div id="btnInsert" type="button" onclick="showDialogCustomer('')" class="btn btn-primary" style="font-size: 1.2rem;margin-left:0.5rem;"><i class="fas fa-user-plus"></i> 新增客戶</div>
<div class="col-12 col-md-12 col-sm-12">
    <table id="customerTable" style="width:100%;">
        <thead>
            <tr style="background-color: #FFF;">
                <th>ID</th>
                <th>運送類型</th>
                <th>CUST_ID</th>
                <th>CUSTOMER</th>
                <th>TRANS_NO</th>
                <th>TRANS_NAME</th>
                <th>是否包稅</th>
                <th>是否包稅中文</th>
                <th>物流公司</th>
                <th>手續費</th>
                <th>菜鳥尊榮服務</th>
                <th>修改</th>
                <th></th>
            </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
        </tfoot>
    </table>
</div>

<!-- modal placeholder-->
<div id='myModal' class='modal fade in'>
    <div class="modal-dialog">
        <div class="modal-content">
            <b class="item-close" onclick="$('#myModal').modal('hide');">x</b>
            <div id='myModalContent'></div>
        </div>
    </div>
</div>

<script>
    $('#collapseUpload').addClass("show");
    $('#SearchCustomer').addClass("active");

    $(function () {
        getCustomerList();
    });

    function getCustomerList() {
        $.ajax({
            url: Router.action('Customer', 'GetCustomer'),
            type: "POST",   //用POST的方式
            dataType: "json",   //response的資料格式
            //data: { "data": JSON.stringify(obj) },
            //async: false,
            success: function (response) {
                let data = JSON.parse(response);
                //console.log(response);
                //datatable更多Responsive用法請參考
                //https://datatables.net/extensions/responsive/examples/

                //此設定參考於這篇
                //datatable套件參考網址
                //https://datatables.net/extensions/responsive/examples/child-rows/right-column.html
                $('#customerTable').DataTable({
                    paging: false,
                    language: {
                        "url": "../Scripts/DataTables/Chinese-traditional.json",
                    },
                    destroy: true,  //Cannot reinitialise DataTable,解决重新載入問題
                    data: data,
                    responsive: {
                        details: {
                            type: 'column',
                            target: -1
                        }
                    },
                    columns: [
                          { "data": "ID" },
                          { "data": "TRAN_TYPE" },
                          { "data": "CUST_ID" },
                          { "data": "CUSTOMER" },
                          { "data": "TRANS_NO" },
                          { "data": "TRANS_NAME" },
                          { "data": "INCLUDE_TAX" },
                          { "data": "INCLUDE_TAX_NAME" },
                          { "data": "COMPANY" },
                          { "data": "COD_FEE" },
                          { "data": "ISCAINIAOP" },
                          {
                              //參考https://dotblogs.com.tw/shadow/2018/04/03/065712
                              "data": "ID",//資料行繫結屬性
                              orderable: false, // 禁用排序
                              render: function (data, type, row, meta) {
                                  //row指的是資料列物件 data變數相等於row.sysid
                                  return "<input type='button' value='修改' onclick=showDialogCustomer('" + data + "') />";
                              }
                          },
                          { "defaultContent": "" }
                    ],
                    columnDefs: [{
                        className: 'control',
                        orderable: false,
                        targets: -1
                    },
                    {
                        visible: false,
                        searchable: false
                    }
                    ]
                });
                new $.fn.dataTable.FixedHeader($('#customerTable').DataTable());
            }
        });
    }

    function showDialogCustomer(id) {
        $('#myModalContent').load(Router.action('Customer', 'DialogCustomer') + "?id="+id+"", function () {
            $('#myModal').modal({
                /*backdrop: 'static',*/
                keyboard: true
            }, 'show');
        });
        return false;
    }



</script>