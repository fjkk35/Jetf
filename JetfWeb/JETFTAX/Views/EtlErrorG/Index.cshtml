@model JETFTAX.Models.EtlErrorG.EtlErrorGViewModel
@{
    ViewBag.Title = "EtlErrorG";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">空快B6F錯單G表</span>
<hr />
<form id="DownloadFileForm" action="@Url.Action("EtlErrorGExcel", "EtlErrorG")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin-bottom:0.5rem;">
        @Html.LabelFor(m => m.SDate)
        @Html.TextBoxFor(m => m.SDate, new { @class = "form-control" })~
        @Html.TextBoxFor(m => m.EDate, new { @class = "form-control" })
    </div>
    <div class="col-lg-12">
        @Html.CheckBoxFor(m => m.IsSearch,new { @style = "height:auto" })
        @Html.LabelFor(m => m.IsSearch)
    </div>
    <div id="btntDownload" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem; "><i class="fas fa-download"></i> 下載</div>
    <div class="loader loader-bar" data-rounded data-text="檔案下載中"></div>
</form>


<script>
        $('#collapseCCLWork').addClass("show");
        $('#EtlErrorG').addClass("active");

        //日期
        $('#SDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' });
        });

        $('#EDate').click(function () {
            WdatePicker({ dateFmt: 'yyyy-MM-dd HH:mm:ss' });
        });

        $('#btntDownload').click(function () {
            //$("#DownloadFileForm").submit();
            $('.loader').addClass("is-active");
            var postData = new FormData($('#DownloadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('EtlErrorG', 'EtlErrorGExcel'),
                data: postData,
                cache: false,
                dataType: 'json',
                processData: false,
                //async: false,
                contentType: false,
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.msg != "") {
                            swal({
                                title: data.msg,
                                icon: "error"
                            });
                        }
                        else if (data.fileName != "") {
                            var path = Router.action('Download', 'DownloadFile') + '?fileGuid=' + data.fileGuid
                                + '&filename=' + data.fileName;
                            //window.location = path;
                            window.open(path);
                        }
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            })
        })
</script>

