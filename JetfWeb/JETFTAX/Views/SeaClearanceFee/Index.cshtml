@model JETFTAX.Models.SeaClearanceFee.SeaClearanceFeeViewModel

@using JETFTAX.Extensions
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script type="text/x-jquery-tmpl" id="seaClearanceFeeTmpl">
    <tr>

        <td>
            <input type="hidden" name="SeaClearanceCustTaxPayment.Index" value="${seq}" />
            <input type="hidden" name="SeaClearanceCustTaxPayment[${seq}].Id" value="${Id}" />
            ${CustCode}-${CustName}
        </td>
        <td style="text-align:right">${X2Fee}</td>
        <td style="text-align:right">${G1Fee}</td>
        <td style="text-align:right">${MoveWarehouseFee}</td>
        <td style="text-align:right">${TransferG1Fee}</td>
        <td style="text-align:right">${TransferWarehouseFee}</td>
        <td>
            <button class="btn btn-danger" onclick="deleteCustomer('${Id}','${CustCode}-${CustName}')">刪除</button>
        </td>
    </tr>
</script>

<span class="headtype">海快後段報關費用</span>
<hr />

<div class="col-12">
    <div class="col-12 mb-3">
        <label class="col-1 text-right">客戶</label>
        @Html.DropDownListFor(m => m.CustCode, Model.CustList, new { @class = "form-control" })
    </div>
    <div class="col-12 mb-3">
        <label class="col-1 text-right">X2、X3費用</label> 
        @Html.TextBoxFor(m => m.X2Fee, new { @class = "form-control", @type = "number" })
    </div>
    <div class="col-12 mb-3">
        <label class="col-1 text-right">G1費用</label>
        @Html.TextBoxFor(m => m.G1Fee, new { @class = "form-control", @type = "number" })
    </div>
    <div class="col-12 mb-3">
        <label class="col-1 text-right">移倉費用</label>
        @Html.TextBoxFor(m => m.MoveWarehouseFee, new { @class = "form-control", @type = "number" })
    </div>
    <div class="col-12 mb-3">
        <label class="col-1 text-right">轉G1</label> 
        @Html.TextBoxFor(m => m.TransferG1Fee, new { @class = "form-control", @type = "number" })
    </div>
    <div class="col-12 mb-3">
        <label class="col-1 text-right">轉移倉</label>
        @Html.TextBoxFor(m => m.TransferWarehouseFee, new { @class = "form-control", @type = "number" })
    </div>
    <div id="btntSearch" class="col-1 offset-1 btn btn-success" onclick="create()" style="font-size: 1.2rem;"><i class="fas fa-plus"></i> 新增</div>
</div>

<hr />
<div class="col-6">
    <table id="table" class="dataTable no-footer dtr-column" border="1">
        <thead>
            <tr>
                <th>客戶</th>
                <th>X2、X3費用</th>
                <th>G1費用</th>
                <th>移倉費用</th>
                <th>轉G1</th>
                <th>轉移倉</th>
                <th>刪除</th>
            </tr>
        </thead>
    </table>
</div>

<!-- modal placeholder-->
<div id='myModal' class='modal fade in'>
    <div class="modal-dialog">
        <div class="modal-content" style="height:30rem;">
            <b class="item-close" onclick="$('#myModal').modal('hide');">x</b>
            <div id='myModalContent'></div>
        </div>
    </div>
</div>

<script>
    $('#collapseSeaClearance').addClass("show");
    $('#SeaClearanceFee').addClass("active");

    $(function () {
        if ('@Model.List.Count' != '0')
        {
            let itemList = (@Model.List.ToJsonRaw());

            for (i = 0; i < itemList.length; i++)
            {
                let data = itemList[i];
                data.seq = i + 1;
                $('#seaClearanceFeeTmpl').tmpl(data).appendTo('#table');
            }
        }
    })


    function create() {
        var custCode = $('#CustCode').val();
        var x2Fee = $('#X2Fee').val();
        var g1Fee = $('#G1Fee').val();
        var moveWarehouseFee = $('#MoveWarehouseFee').val();
        var transferG1Fee = $('#TransferG1Fee').val();
        var transferWarehouseFee = $('#TransferWarehouseFee').val();

        $.ajax({
            type: "POST",
            url: '@Url.Action("Create", "SeaClearanceFee")',
            data: {
                CustCode: custCode,
                X2Fee: x2Fee,
                G1Fee: g1Fee,
                MoveWarehouseFee: moveWarehouseFee,
                TransferG1Fee: transferG1Fee,
                TransferWarehouseFee: transferWarehouseFee
            },
            success: function (data) {
                if (data.status == "success") {
                    swal({
                        title: "新增成功",
                        icon: "success"
                    }).then(function () {
                        location.reload(); // 重新整理頁面
                    });
                } else {
                    swal({
                        title: data.msg,
                        icon: "error"
                    });
                }
            },
            error: function () {
                swal({
                    title: "新增失敗",
                    icon: "error"
                });
            }
        });
    }

    function deleteCustomer(id, customer) {
         swal({
        title: "確認刪除",
        text: `您確定要刪除${customer}？`,
        icon: "warning",
        buttons: true,
        dangerMode: true,
    }).then((willDelete) => {
        if (willDelete) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Delete", "SeaClearanceFee")',
                data: { id: id },
                success: function (data) {
                    if (data.status == "success") {
                        swal({
                            title: "刪除成功",
                            icon: "success"
                        }).then(function () {
                            location.reload(); // 重新整理頁面
                        });
                    } else {
                        swal({
                            title: data.msg,
                            icon: "error"
                        });
                    }
                },
                error: function () {
                    swal({
                        title: "刪除失敗",
                        icon: "error"
                    });
                }
            });
        }
    });

    }



</script>