
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="headtype">上傳拆櫃紀錄</span>
<hr />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<form id="UploadFileForm" action="@Url.Action("", "")" method="post" enctype="multipart/form-data" class="containertype">
    <div class="col-lg-12" style="margin:0.5rem 0;">
        <input type="file" name="file" id="fileTax" accept=".xlsx" />
    </div>
    <div class="col-lg-12" style="margin:0.5rem 0;">
        <a href='~/Download/DownloadExample?filePath=@AppDomain.CurrentDomain.BaseDirectory\Download\上傳拆櫃紀錄範例.xlsx&fileName=上傳拆櫃紀錄範例.xlsx' target='_blank'>下載拆櫃紀錄範例</a>
    </div>
    <div id="btntUploadFile" type="button" class="btn btn-primary confirmbtn col-lg-3" style="font-size: 1.2rem;"><i class="fas fa-upload"></i> 上傳</div>

    <div class="loader loader-bar" data-rounded data-text="檔案上傳中"></div>
</form>

@{
    <script>

        $('#collapseSeaWork').addClass("show");
        $('#SeaUnboxingRecord').addClass("active");

        function showUploadError(data) {
            var errors = data && data.ReturnObject && data.ReturnObject.length ? data.ReturnObject : [];

            if (errors.length > 0 && window.swal) {
                var wrapper = document.createElement('div');
                wrapper.style.textAlign = 'left';
                wrapper.style.maxHeight = '300px';
                wrapper.style.overflowY = 'auto';

                var title = document.createElement('div');
                title.style.marginBottom = '10px';
                title.textContent = data.msg || '上傳失敗';
                wrapper.appendChild(title);

                var list = document.createElement('ul');
                list.style.paddingLeft = '20px';
                list.style.margin = '0';

                errors.forEach(function (item) {
                    var li = document.createElement('li');
                    li.textContent = item;
                    list.appendChild(li);
                });

                wrapper.appendChild(list);

                swal({
                    title: '上傳失敗',
                    content: wrapper,
                    icon: 'error'
                });

                return;
            }

            swal({
                title: '上傳失敗',
                text: data.msg || '發生錯誤',
                icon: 'error'
            });
        }

        $('#btntUploadFile').click(function () {
            $('.loader').addClass("is-active");

            var file = document.getElementById('fileTax');
            var postData = new FormData($('#UploadFileForm')[0]);
            $.ajax({
                type: "POST",
                url: Router.action('SeaUnboxingRecord', 'Upload'),
                data: postData,
                cache: false,
                dataType: 'json',
                processData: false,
                //async: false,
                contentType: false,
                success: function (data) {
                    if (data.Redirect) {
                        window.location = Router.action('Account', 'Login');
                    }
                    else {
                        if (data.status == "success") {
                            swal({
                                title: "上傳成功",
                                icon: "success"
                            });
                        }
                        else {
                            showUploadError(data);
                        }

                        file.outerHTML = file.outerHTML; //重置了file的outerHTML
                    }
                }
            }).then(function () {
                $('.loader').removeClass("is-active");
            });
        })
    </script>

}
